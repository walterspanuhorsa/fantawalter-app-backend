        <DBMapperTableEntries expression="month(sap.BKPF.BUDAT) as budat_month" name="BUDAT_MONTH"/>
        <DBMapperTableEntries expression="day(sap.BKPF.BUDAT) as budat_day" name="BUDAT_DAY"/>
        <DBMapperTableEntries expression="sap.BKPF.CPUDT " name="CPUDT"/>
