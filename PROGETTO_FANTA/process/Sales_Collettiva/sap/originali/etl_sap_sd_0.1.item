        <DBMapperTableEntries expression="vbak.VKORG " name="VKORG"/>
        <DBMapperTableEntries expression="vbak.VTWEG " name="VTWEG"/>
        <DBMapperTableEntries expression="mara.MATNR " name="MATNR"/>
        <DBMapperTableEntries expression="mvke.PRODH " name="PRODH"/>
        <DBMapperTableEntries expression="if(substr(mvke.prodh, 1, 3)='PAS', if (vbak.auart in('ZANZ', 'ZDDT'), 'Asporto', 'Somministrazione'), 'Altro') as asporto_somministrazione" name="asporto_somministrazione"/>
        <DBMapperTableEntries expression="vbap.PRODH as vbap_prodh" name="VBAP_PRODH"/>
        <DBMapperTableEntries expression="vbrp.PRODH as vbrp_prodh" name="VBRP_PRODH"/>
        <DBMapperTableEntries expression="vbap.PS_PSP_PNR " name="PS_PSP_PNR"/>
        <DBMapperTableEntries expression="vbap.ABGRU " name="ABGRU"/>
        <DBMapperTableEntries expression="vbap.WERKS " name="WERKS"/>
        <DBMapperTableEntries expression="vbrp.POSNR " name="POSNR"/>
        <DBMapperTableEntries expression="vbrp.NETWR " name="NETWR"/>
        <DBMapperTableEntries expression="vbrp.MWSBP" name="MWSBP"/>
        <DBMapperTableEntries expression="if(vbrp.shkzg='', 1*vbrp.netwr, -1*vbrp.netwr) as importo" name="importo"/>
        <DBMapperTableEntries expression="if(vbrp.shkzg='', 1*vbrp.mwsbp, -1*vbrp.mwsbp) as importo_iva" name="importo_iva"/>
        <DBMapperTableEntries expression="vbrp.LMENG " name="LMENG"/>
        <DBMapperTableEntries expression="if(vbrp.shkzg='', 1*vbrp.lmeng, -1*vbrp.lmeng) as quantita" name="quantita"/>
        <DBMapperTableEntries expression="vbrp.SHKZG " name="SHKZG"/>
        <DBMapperTableEntries expression="if(vbrp.shkzg='', 1, -1) as segno" name="segno"/>
        <DBMapperTableEntries expression="mara.ZQTASIGN " name="ZQTASIGN"/>
        <DBMapperTableEntries expression="if (vbak.auart in('ZTIK', 'ZCOD'),  if(vbrp.shkzg='', 1, -1) * if(vbak.auart='ZTIK' and vbrp.zcoperti = 0, vbrp.FKIMG, vbrp.zcoperti)  ,        if(mara.zqtasign='01', 1, if(mara.zqtasign='02', 2, 0)) * if(vbrp.shkzg='', 1*vbrp.lmeng, -1*vbrp.lmeng)  ) as pasti&#13;&#10;" name="pasti"/>
        <DBMapperTableEntries expression="wbpa_we.KUNNR as kunnr_we" name="KUNNR_WE"/>
        <DBMapperTableEntries expression="vbpa_rp_out.KUNNR as kunnr_rg" name="KUNNR_RG"/>
        <DBMapperTableEntries expression="prps.POSID " name="POSID"/>
        <DBMapperTableEntries expression="prps.POST1 " name="POST1"/>
        <DBMapperTableEntries expression="kna1.ZZSPED " name="ZZSPED"/>
        <DBMapperTableEntries expression="if(KNA1.ZZSPED='Z7', 'Pubblico', if(KNA1.ZZSPED='Z8', 'Privato',  'Non Attribuito'))" name="pubblico_privato"/>
        <DBMapperTableEntries expression="if(vbrp.augru_auft in ('Z09') or vbrp.ktgrm in ('43', '28'), 'Sopravvenienza Attiva', 'Fatturato') as tipo_ricavo" name="tipo_ricavo"/>
        <FilterEntries expression="(vbrp.augru_auft not in ('Z06','Z07') and vbrp.ktgrm not in ('52', '04', '03'))" filterKind="WHERE_FILTER" name="newFilter2"/>
      </OutputTables>
    </nodeData>
  </node>
