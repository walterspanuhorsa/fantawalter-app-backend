      <OutputTables name="table4" tableName="Fatturato_fi">
        <DBMapperTableEntries expression="'Scolastica' as prepagato" name="prepagato"/>
        <DBMapperTableEntries expression="year(bkpf.BUDAT) as budat_year" name="budat_year"/>
        <DBMapperTableEntries expression="month(bkpf.budat) as budat_month" name="budat_month"/>
        <DBMapperTableEntries expression="sap.BKPF.BUDAT " name="BUDAT"/>
        <DBMapperTableEntries expression="sap.BSEG.BELNR " name="BELNR"/>
        <DBMapperTableEntries expression="sap.BSEG.BUZEI " name="BUZEI"/>
        <DBMapperTableEntries expression="sap.BKPF.BKTXT " name="BKTXT"/>
        <DBMapperTableEntries expression="bseg_cli.SGTXT " name="SGTXT"/>
        <DBMapperTableEntries expression="sap.BSEG.MATNR " name="MATNR"/>
        <DBMapperTableEntries expression="sap.BSEG.SHKZG " name="SHKZG"/>
        <DBMapperTableEntries expression="if(bseg.shkzg='H',1 , -1) as segno" name="segno"/>
        <DBMapperTableEntries expression="sap.BSEG.HKONT " name="HKONT"/>
        <DBMapperTableEntries expression="sap.BSEG.MENGE " name="MENGE"/>
        <DBMapperTableEntries expression="if(bseg.shkzg='H',1 , -1) * bseg.menge as quantita" name="quantita"/>
        <DBMapperTableEntries expression="sap.BSEG.DMBTR " name="DMBTR"/>
        <DBMapperTableEntries expression="if(bseg.shkzg='H',1 , -1) * bseg.dmbtr as importo" name="importo"/>
        <DBMapperTableEntries expression="round(bseg.dmbtr/bseg.menge,2) as prezzo" name="prezzo"/>
