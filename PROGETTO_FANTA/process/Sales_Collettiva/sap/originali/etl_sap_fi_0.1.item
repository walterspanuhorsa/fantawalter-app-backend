        <DBMapperTableEntries expression="prps.POST1 " name="POST1"/>
        <DBMapperTableEntries expression="if(bkpf.tcode='ZSD011', 'Cassa Intelligente', if(bkpf.tcode='FB50', 'Cassa Stupida', 'Altro')) as tipo_cassa" name="tipo_cassa"/>
        <FilterEntries expression="sap.BKPF.TCODE in ('ZSD011', 'FB50')" filterKind="WHERE_FILTER" name="newFilter1"/>
      </OutputTables>
