  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="768" posY="192">
    <elementParameter field="TEXT" name="UNIQUE_NAME" show="false" value="tJava_1"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="if (((Integer)globalMap.get(&quot;tDBOutput_1_NB_LINE_DELETED&quot;)) == 1){&#10;context.message= &quot;{\&quot;message\&quot; : \&quot;Record con ID = &quot; + context.customerNumber + &quot; cancellato\&quot;}&quot;;&#10;} else if (((Integer)globalMap.get(&quot;tDBOutput_1_NB_LINE_DELETED&quot;)) &gt; 1 ) {&#10;context.message= &quot;{\&quot;message\&quot; : \&quot;Cancellati &quot;+((Integer)globalMap.get(&quot;tDBOutput_1_NB_LINE_DELETED&quot;))+&quot; Record con ID = &quot; + context.customerNumber + &quot;\&quot;}&quot;;&#10;} else{&#10;context.message= &quot;{\&quot;message\&quot; : \&quot;Non è stato trovato alcun record con ID = &quot; + context.customerNumber + &quot;\&quot;}&quot;;&#10;}&#10;&#10;&#10;&#10;//System.out.println(context.message);"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
