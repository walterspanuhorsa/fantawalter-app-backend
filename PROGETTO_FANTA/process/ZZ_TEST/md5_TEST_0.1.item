  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="640" posY="224">
    <elementParameter field="TEXT" name="UNIQUE_NAME" show="false" value="tJavaRow_1"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="// Genera il codice di controllo MD5 su tutti i campi dello schema in entrata &#10;// usa reflection class&#10;&#10;&#10;Field[] input_row_f = input_row.getClass().getDeclaredFields();&#10;String MD5String = &quot;&quot;;&#10;&#10;for (int i = 0; i &lt; input_row_f.length; i++) {&#10;Field input_field = input_row_f[i];&#10;&#10;int mod = input_field.getModifiers();&#10;if (!Modifier.isStatic(mod) &amp;&amp; Modifier.isPublic(mod)) {&#10;MD5String = MD5String + input_field.get(input_row);&#10;//System.out.println(MD5String);&#10;&#9;}&#10;}&#10;output_row.ConcatString_v1 = MD5String;&#10;output_row.MD5_v1 = MD5.getHashString(MD5String);&#10;&#10;output_row.ConcatString_v2 = input_row.toString();&#10;output_row.MD5_v2 = MD5.getHashString(input_row.toString());"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="&#9;&#9;&#9;//import java.util.List;&#10;import java.lang.reflect.*;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
      <column comment="" key="false" length="-1" name="MD5_v1" nullable="true" originalLength="-1" pattern="" precision="-1" sourceType="" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="ConcatString_v1" nullable="true" originalLength="-1" pattern="" precision="-1" sourceType="" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="MD5_v2" nullable="true" originalLength="-1" pattern="" precision="-1" sourceType="" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="ConcatString_v2" nullable="true" originalLength="-1" pattern="" precision="-1" sourceType="" type="id_String" usefulColumn="true"/>
    </metadata>
  </node>
