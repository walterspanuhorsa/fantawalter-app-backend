    <elementParameter field="MEMO_JAVA" name="CODE" value="context.url=&quot;https://www.gazzetta.it/calcio/fantanews/statistiche/serie-a-2024-25&quot;;&#10;&#10;&#10;String[] aSource = jobName.split(&quot;_&quot;);&#10;&#10;context.source = aSource[0];&#10;&#10;context.table_name = context.source +&quot;_listone&quot;;&#10;&#10;&#10;&#10;context.file_name = &quot;Listone_&quot;+context.source+&quot;.csv&quot;;&#10;&#10;&#10;context.fantacalcioTable  = &quot;listone_fantacalcioit&quot;;&#10;&#10;&#10;&#10;context.filePath = &quot;/tmp/fanta/&quot; + context.source  +&quot;/&quot;;&#10;&#10;&#10;context.counter = 0;&#10;&#10;System.out.println(&quot;URL: &quot;+ context.url);&#10;&#10;System.out.println(&quot;TABELLA DI RIFERIMENTO: &quot;+ context.table_name);&#10;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
