    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select distinct FCit.id, FCit.R RUOLO,&#13;&#10;FCit.Nome, FCit.Squadra, &#13;&#10;case when stat.Pv is null then 0 else stat.Pv end  giocate,&#13;&#10;case when stat.Mv is null then 0 else stat.Mv end  mediavoto,&#13;&#10;case when stat.Fm is null then 0 else stat.Fm end  fantamedia,&#13;&#10;lc.Tit,&#13;&#10;lc.SICU,&#13;&#10;lc.INF,&#13;&#10;FCit.FVM_CALCOLATO as FVMC_FCit,&#13;&#10;club.FVM_CALCOLATO as FVMC_Club,&#13;&#10;pf.FVM_CALCOLATO  as FVMC_Pf,&#13;&#10;Fm.FVM_CALCOLATO as FVMC_Fm,&#13;&#10;gds.FVM_CALCOLATO  as FVMC_Gds,&#13;&#10;fs.FVM_CALCOLATO  as FVMC_Fs,&#13;&#10;pazz.FVM_CALCOLATO  as FVMC_Pazz,&#13;&#10;lc.Carmy_Prezzo,&#13;&#10;FCit.FVM  as FVM_FCit,&#13;&#10;ge.FVM as FVM_GE,&#13;&#10;lc.media_leghe MEDIE_LEGHE,&#13;&#10;lc.Note&#13;&#10;from fanta.listone_fantacalcioit_202324 FCit&#13;&#10;left join fanta.statistiche_giocatori_202324 stat &#13;&#10;&#9;on stat.id = FCit.id&#13;&#10;left join fanta.listone_fantaclub_202324 club &#13;&#10;&#9;on club.id = FCit.id&#13;&#10;left join fanta.listone_gds_202324 gds &#13;&#10;&#9;on gds.id = FCit.id&#13;&#10;left join fanta.listone_fantamaster_202324 Fm   &#13;&#10;&#9;on Fm.id = FCit.id&#13;&#10;left join listone_PianetaFanta_202324 pf &#13;&#10;&#9;on Pf.id = fcit.id&#13;&#10;left join listone_fantaSoccer_202324 fs &#13;&#10;&#9;on fs.id = fcit.id&#13;&#10;left join listone_fantaPazz_202324 pazz &#13;&#10;&#9;on pazz.id = fcit.id&#13;&#10;left join listone_medieaste_202324 ge&#13;&#10;&#9;on ge.id = fcit.id&#13;&#10;left join listone_carmy_202324 lc &#13;&#10;&#9;on lc.id =fcit.id&#13;&#10;where FCit.POSIZIONE is not null and FCit.R &lt;&gt;'P'&#13;&#10;order by FCit.POSIZIONE  asc&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
