    <elementParameter field="MEMO_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#10;&#10;//System.out.println(input_row.Nome +&quot; =&gt; &quot;+ input_row.FVM_FCit + &quot; &quot; + input_row.FVMC_FCit  + &quot; &quot; + input_row.FVMC_Club + &quot; &quot; +input_row.FVMC_Gds + &quot; &quot; + input_row.FVMC_Fm + &quot; &quot; +input_row.FVMC_Pf);&#10;&#10;Integer FVMC_FCit = Relational.ISNULL(input_row.FVMC_FCit)? input_row.FVM_FCit :  input_row.FVMC_FCit;&#10;Integer FVMC_Club = Relational.ISNULL(input_row.FVMC_Club)? input_row.FVM_FCit :  input_row.FVMC_Club;&#10;Integer FVMC_Gds = Relational.ISNULL(input_row.FVMC_Gds)? input_row.FVM_FCit :  input_row.FVMC_Gds;&#10;Integer FVMC_Fm = Relational.ISNULL(input_row.FVMC_Fm)? input_row.FVM_FCit :  input_row.FVMC_Fm;&#10;Integer FVMC_Pf = Relational.ISNULL(input_row.FVMC_Pf)? input_row.FVM_FCit :  input_row.FVMC_Pf;&#10;Integer FVMC_Fs = Relational.ISNULL(input_row.FVMC_Fs)? input_row.FVM_FCit :  input_row.FVMC_Fs;&#10;Integer FVMC_Pazz = Relational.ISNULL(input_row.FVMC_Pazz)? input_row.FVM_FCit :  input_row.FVMC_Pazz;&#10;&#10;&#10;Integer Carmy_Prezzo = Relational.ISNULL(input_row.Carmy_Prezzo)? input_row.FVM_FCit :  input_row.Carmy_Prezzo;&#10;Integer LEGHE_GE = Relational.ISNULL(input_row.FVM_GE)? input_row.FVM_FCit :  input_row.FVM_GE;&#10;Integer LEGHE_FL = Relational.ISNULL(input_row.MEDIE_LEGHE)? input_row.FVM_FCit :  input_row.MEDIE_LEGHE;&#10;&#10;Integer FVM_FCit  = input_row.FVM_FCit;&#10;&#10;FVMC_FCit = fanta.returnFMVC(input_row.FVM_FCit , FVMC_FCit);&#10;FVMC_Club = fanta.returnFMVC(input_row.FVM_FCit , FVMC_Club);&#10;FVMC_Gds = fanta.returnFMVC(input_row.FVM_FCit ,  FVMC_Gds);&#10;FVMC_Fm = fanta.returnFMVC(input_row.FVM_FCit , FVMC_Fm);&#10;FVMC_Pf = fanta.returnFMVC(input_row.FVM_FCit , FVMC_Pf);&#10;FVMC_Fs = fanta.returnFMVC(input_row.FVM_FCit , FVMC_Fs);&#10;FVMC_Pazz = fanta.returnFMVC(input_row.FVM_FCit , FVMC_Pazz);&#10;&#10;LEGHE_GE = fanta.returnFMVC(input_row.FVM_FCit , LEGHE_GE);&#10;LEGHE_FL = fanta.returnFMVC(input_row.FVM_FCit , LEGHE_FL);&#10;Carmy_Prezzo = fanta.returnFMVC(input_row.FVM_FCit , Carmy_Prezzo);&#10;&#10;&#10;//System.out.println(input_row.Nome +&quot; =&gt; &quot;+ FVM_FCit + &quot; &quot; + FVMC_FCit  + &quot; &quot; + FVMC_Club + &quot; &quot; +FVMC_Gds + &quot; &quot; + FVMC_Fm + &quot; &quot; +FVMC_Pf);&#10;&#10;Integer[] quotazioni= {FVM_FCit, FVMC_FCit, FVMC_Club, FVMC_Gds, FVMC_Fm,FVMC_Pf,FVMC_Fs,FVMC_Pazz, LEGHE_GE, LEGHE_FL, Carmy_Prezzo };&#10;&#10;&#10;Arrays.sort(quotazioni);&#10;&#10;Integer[] modifiedArray = Arrays.copyOfRange(quotazioni, 1, quotazioni.length);&#10;&#10;&#10;//elimino il valore più basso&#10;modifiedArray = Arrays.copyOfRange(quotazioni, 1, quotazioni.length);&#10;modifiedArray = Arrays.copyOfRange(quotazioni, 1, quotazioni.length);&#10;&#10;//elimino il valore più alto&#10;modifiedArray = Arrays.copyOfRange(modifiedArray, 0, modifiedArray.length-1);&#10;modifiedArray = Arrays.copyOfRange(modifiedArray, 0, modifiedArray.length-1);&#10;&#10;quotazioni = modifiedArray;&#10;&#10;    double somma; int media;&#10;&#10;    somma=0;&#10;&#10;    for(int i=0; i&lt;=quotazioni.length-1; i=i+1) {&#10;    &#10;    //System.out.println(input_row.Nome + &quot; =&gt; &quot; +quotazioni[i]);&#10;      somma=somma+quotazioni[i];&#10;    }&#10;&#10;    media= (int) Math.round(somma/quotazioni.length);&#10;&#10;&#10;&#13;&#10;output_row.id = input_row.id;&#10;output_row.R = input_row.R;&#13;&#10;output_row.Nome = input_row.Nome;&#13;&#10;output_row.Squadra = input_row.Squadra;&#10;&#13;&#10;output_row.MEDIA_TRONCATA = media;&#10;output_row.FVM_FCit =FVM_FCit;&#10;output_row.LEGHE_GE = LEGHE_GE;&#10;output_row.LEGHE_FL = LEGHE_FL;&#10;output_row.Carmy_Prezzo = Carmy_Prezzo;&#10;&#10;output_row.giocate = input_row.giocate;&#10;output_row.mediavoto = input_row.mediavoto;&#10;output_row.fantamedia = input_row.fantamedia;&#10;&#10;&#10;output_row.TIT = input_row.TIT;&#10;output_row.SICU = input_row.SICU;&#10;output_row.INF = input_row.INF;&#10;output_row.Note = input_row.Note;&#10;&#10;output_row.FASCIA = null;&#10;output_row.POSIZIONE = null;&#10;&#13;&#10;output_row.FVMC_FCit  =  input_row.FVMC_FCit;&#10;output_row.FVMC_Club  =  input_row.FVMC_Club;&#10;output_row.FVMC_Gds   =  input_row.FVMC_Gds;&#10;output_row.FVMC_Fm    =  input_row.FVMC_Fm;&#10;output_row.FVMC_Pf    =  input_row.FVMC_Pf;&#10;output_row.FVMC_Fs    =  input_row.FVMC_Fs;&#10;output_row.FVMC_Pazz  =  input_row.FVMC_Pazz;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="import java.util.Arrays;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
