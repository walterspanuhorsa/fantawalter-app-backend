    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select src.Sorgente, src.Squadra,TRIM(src.Nome), f.Squadra, TRIM(f.Nome)&#xD;&#xA;from (select GID&#xD;&#xA;&#x9;from fanta.match_insertnomifantamaster &#xD;&#xA;&#x9;group by GID having Count(*) = 2 and  Max(Sorgente) &lt;> min(Sorgente) ) t&#xD;&#xA;JOIN fanta.match_insertnomifantamaster f&#xD;&#xA;&#x9;on t.GID = f.GID and f.Sorgente ='fantacalcio.it'&#xD;&#xA;JOIN fanta.match_insertnomifantamaster src&#xD;&#xA;&#x9;on t.GID = src.GID and src.Sorgente ='Fantamaster'&#xD;&#xA;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
