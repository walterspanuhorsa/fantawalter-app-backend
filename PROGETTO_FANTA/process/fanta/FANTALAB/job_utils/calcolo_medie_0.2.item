    <elementParameter field="PASSWORD" name="PASS" show="false" value="enc:system.encryption.key.v1:3QNYFYFY6EqIVe/8JTohOcE8SZNjx2NT+sPuEOyMDXJWJtX87PVIcPW2BVjDiWDIAQfGLygeICo="/>
    <elementParameter field="DBTABLE" name="TABLE" value="context.table_name"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" show="false" value=""/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT DISTINCT &#13;&#10;cl.R RUOLO,&#13;&#10;cl.Nome, cl.Squadra, &#13;&#10;cl.Titolarita as TIT,&#13;&#10;cl.Affidabilita as SICU,&#13;&#10;cl.Integrita as INF,&#13;&#10;cl.Fascia as FASCIA,&#13;&#10;cl.PMA  as FVM_PMA_FL,&#13;&#10;cl.Prezzo as FVM_Carmy,&#13;&#10;pl.Prezzo as FVM_Profeta,&#13;&#10;lc.Prezzo as FVM_Canta,&#13;&#10;rl.Prezzo as FVM_Recosta,&#13;&#10;sos.Prezzo as FVM_SOS,&#13;&#10;ld.Prezzo as FVM_LD,&#13;&#10;cl.Nota_1, cl.Nota_2, cl.Nota_3, cl.Nota_4, cl.Nota_5,&#13;&#10;cl.MV, cl.FMV, cl.Presenze, cl.FMV_Exp,&#13;&#10;COALESCE(cl.Commento, COALESCE(pl.commento, COALESCE(lc.Commento, COALESCE(rl.commento, COALESCE(sos.commento, COALESCE(ld.commento, null))))))&#13;&#10;from fantalab.carmyspecial_listone cl&#13;&#10;left join fantalab.ilprofeta_listone pl on cl.Nome = pl.Nome &#13;&#10;left join fantalab.ilprofeta_listone lc on cl.Nome = lc.Nome &#13;&#10;left join fantalab.recosta_listone rl on cl.Nome = rl.Nome&#13;&#10;left join fantalab.sosfanta_listone sos on cl.Nome = sos.Nome&#13;&#10;left join fantalab.lucadiddi_iltattico_listone ld on cl.Nome = ld.Nome&#13;&#10;order by FVM_Carmy desc&quot;"/>
    <elementParameter field="LABEL" name="NOTE" show="false" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" show="false" value="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" show="false" value="&quot;&quot;"/>
    <elementParameter field="MAPPING_TYPE" name="MAPPING" show="false" value="mysql_id"/>
    <elementParameter field="TEXT" name="PROPERTIES" show="false" value="context.mysql_fanta_AdditionalParams"/>
    <elementParameter field="ENCODING_TYPE" name="ENCODING" show="false" value="&quot;ISO-8859-15&quot;"/>
    <elementParameter field="TECHNICAL" name="ENCODING:ENCODING_TYPE" value="ISO-8859-15"/>
    <elementParameter field="CHECK" name="ENABLE_STREAM" value="false"/>
    <elementParameter field="CHECK" name="TRIM_ALL_COLUMN" value="false"/>
    <elementParameter field="TABLE" name="TRIM_COLUMN">
      <elementValue elementRef="SCHEMA_COLUMN" value="R"/>
      <elementValue elementRef="TRIM" value="false"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="Nome"/>
