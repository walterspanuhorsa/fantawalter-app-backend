  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="760" posY="320">
    <elementParameter field="TEXT" name="UNIQUE_NAME" show="false" value="tJavaRow_1"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="&#10;//popolo l'array&#10;Integer[] quotazioni= {input_row.FVM_PMA_FL,  input_row.FVM_Carmy,  input_row.FVM_Profeta,  input_row.FVM_Canta,  input_row.FVM_Recosta,  input_row.FVM_SOS,input_row.FVM_LD };&#10;&#10;&#10;//riordino l'array&#10;Arrays.sort(quotazioni);&#10;&#10;//creo un array di lavoro&#10;Integer[] modifiedArray = Arrays.copyOfRange(quotazioni, 1, quotazioni.length);&#10;&#10;output_row.MAX = quotazioni[quotazioni.length-1];&#10;output_row.MIN = quotazioni[0];&#10;&#10;&#10;modifiedArray = quotazioni;&#10;&#10;//elimino i due valori più bassi&#10;&#10;&#10;modifiedArray = Arrays.copyOfRange(modifiedArray, 2, quotazioni.length);&#10;&#10;//elimino i due valori più alti&#10;modifiedArray = Arrays.copyOfRange(modifiedArray, 0, modifiedArray.length-2);&#10;&#10;quotazioni = modifiedArray;&#10;&#10;    double somma; int media;&#10;&#10;    somma=0;&#10;&#10;    for(int i=0; i&lt;=quotazioni.length-1; i=i+1) {&#10;    &#10;    //System.out.println(input_row.Nome + &quot; =&gt; &quot; +quotazioni[i]);&#10;      somma=somma+quotazioni[i];&#10;    }&#10;    &#10;    &#10;    &#10;    &#10;&#9;//produco la media arrotondando il valore ottenuto&#10;    media= (int) Math.round(somma/quotazioni.length);&#10;    &#10;    &#10;    //System.out.println(&quot;SOMMA: &quot;+somma + &quot; | LENGTH: &quot; +   modifiedArray.length  + &quot;MEDIA:&quot; + media);&#10;    &#10;    &#10;    &#10;output_row.Nome = input_row.Nome;&#10;&#10;output_row.MEDIA_TRONCATA = media;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="import java.io.*; &#10;import java.lang.*; &#10;import java.util.*; &#10;&#10;import java.lang.reflect.Field;  "/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
      <column comment="" key="false" length="11" name="Nome" nullable="true" originalLength="-1" pattern="" precision="0" sourceType="INT" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="MEDIA_TRONCATA" nullable="true" originalLength="-1" pattern="" precision="-1" sourceType="" type="id_Integer" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="MAX" nullable="true" originalLength="-1" pattern="" precision="-1" sourceType="" type="id_Integer" usefulColumn="true"/>
