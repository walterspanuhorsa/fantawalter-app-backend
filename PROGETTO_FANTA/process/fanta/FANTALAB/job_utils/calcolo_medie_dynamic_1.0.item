  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="400" posY="520">
    <elementParameter field="TEXT" name="UNIQUE_NAME" show="false" value="tJavaRow_1"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="Dynamic columns = input_row.DynamicSchema;&#10;&#10;int[] quotazioni={};&#10;&#10;int PMA_check = 0;&#10;&#10;for (int i = 0; i &lt; columns.getColumnCount(); i++)&#10;{&#10;DynamicMetadata columnMetadata = columns.getColumnMetadata(i);&#10;String col_name=columnMetadata.getName();&#10;&#10;&#10;if(col_name.equals(&quot;Nome&quot;)){&#10;output_row.Nome = (String)columns.getColumnValue(i);&#10;}&#10;&#10;&#10;if(col_name.contains(&quot;PREZZO_&quot;)){&#10;&#9; /*System.out.println(&quot;Column Name = &quot; + col_name);&#10;&#9; System.out.println(&quot;Column Value = &quot; + columns.getColumnValue(i));*/&#10;&#9; Integer col_value = (Integer)columns.getColumnValue(i);&#10;&#9;quotazioni = fanta.addX(quotazioni.length, quotazioni, col_value);&#10;}&#10;&#10;&#10;if(col_name.contains(&quot;PMA&quot;) &amp;&amp; PMA_check == 0){&#10;&#9; //System.out.println(&quot;PMA VALUE = &quot; + (Integer)columns.getColumnValue(i));&#10;&#9; //System.out.println(&quot;Column Value = &quot; + columns.getColumnValue(i));&#10;&#9; Integer col_value = (Integer)columns.getColumnValue(i);&#10;&#9;quotazioni = fanta.addX(quotazioni.length, quotazioni, col_value);&#10;&#9;PMA_check = 1;&#10;}&#10;&#10;&#10;}&#10;&#10;&#10;//System.out.println(&quot;ARRAY = &quot; + Arrays.toString(quotazioni));&#10;&#10;//riordino l'array&#10;Arrays.sort(quotazioni);&#10;&#10;//creo un array di lavoro&#10;int[] modifiedArray = Arrays.copyOfRange(quotazioni, 1, quotazioni.length);&#10;&#10;output_row.MAX = quotazioni[quotazioni.length-1];&#10;output_row.MIN = quotazioni[0];&#10;&#10;&#10;modifiedArray = quotazioni;&#10;&#10;//elimino i due valori più bassi&#10;&#10;&#10;modifiedArray = Arrays.copyOfRange(modifiedArray, 2, quotazioni.length);&#10;&#10;//elimino i due valori più alti&#10;modifiedArray = Arrays.copyOfRange(modifiedArray, 0, modifiedArray.length-2);&#10;&#10;quotazioni = modifiedArray;&#10;&#10;    double somma; int media;&#10;&#10;    somma=0;&#10;&#10;    for(int i=0; i&lt;=quotazioni.length-1; i=i+1) {&#10;    &#10;    //System.out.println(input_row.Nome + &quot; =&gt; &quot; +quotazioni[i]);&#10;      somma=somma+quotazioni[i];&#10;    }&#10;    &#10;    &#10;    &#10;    &#10;&#9;//produco la media arrotondando il valore ottenuto&#10;    media= (int) Math.round(somma/quotazioni.length);&#10;    &#10;    &#10;    //System.out.println(&quot;SOMMA: &quot;+somma + &quot; | LENGTH: &quot; +   modifiedArray.length  + &quot;MEDIA:&quot; + media);&#10;    &#10;    &#10;    &#10;&#10;&#10;output_row.MEDIA_TRONCATA = media;&#10;&#10;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="import java.io.*; &#10;import java.lang.*; &#10;import java.util.*; "/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
