  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="200" posY="480">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="System.out.println(&quot;CREO QUERY E MODIFICO TABELLA &quot; + context.table_name);&#xA;&#xA;&#xA;context.SELECT =&quot;SELECT cl.Nome, cl.PMA, cl.Prezzo as PREZZO_carmyspecial &quot;;&#xA;context.FROM = &quot; FROM fantalab.&quot;+context.table_carmy+&quot; cl &quot;;&#xA;context.CREATETABLE = &quot;CREATE TABLE &quot;+context.table_name+&quot;_valutazioni (Nome varchar(100) NULL, PMA INT NULL, PREZZO_carmyspecial INT NULL, &quot;;&#xA;&#xA;context.CREATEVIEW = &quot;SELECT rep.FASCIA,'' as obbiettivo,rep.Nome,rep.R,rep.Squadra,rep.MEDIA_TRONCATA, rep.MIN, rep.MAX, rep.TIT, rep.SICU, rep.INF, rep.Note, rqv.PMA, rqv.PREZZO_carmyspecial, &quot;;&#xA;&#xA;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>
