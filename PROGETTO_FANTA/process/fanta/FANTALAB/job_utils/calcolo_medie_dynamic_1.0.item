  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="200" posY="360">
    <elementParameter field="TEXT" name="UNIQUE_NAME" show="false" value="tJava_1"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="System.out.println(&quot;CREO QUERY E MODIFICO TABELLA &quot; + context.table_name);&#10;&#10;&#10;context.SELECT =&quot;SELECT cl.Nome, cl.PMA, cl.Prezzo as PREZZO_carmyspecial &quot;;&#10;context.FROM = &quot; FROM fantalab.carmyspecial_listone cl &quot;;&#10;context.CREATETABLE = &quot;CREATE TABLE &quot;+context.table_name+&quot;_valutazioni (Nome varchar(100) NULL, PMA INT NULL, PREZZO_carmyspecial INT NULL, &quot;;&#10;&#10;context.CREATEVIEW = &quot;SELECT rep.FASCIA,'' as obbiettivo,rep.Nome,rep.R,rep.Squadra,rep.MEDIA_TRONCATA, rep.MIN, rep.MAX, rep.TIT, rep.SICU, rep.INF, rep.Note, rqv.PMA, rqv.PREZZO_carmyspecial, &quot;;&#10;&#10;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>
