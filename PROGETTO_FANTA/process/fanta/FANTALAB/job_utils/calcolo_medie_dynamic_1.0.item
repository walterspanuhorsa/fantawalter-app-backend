  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="400" posY="640">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="Dynamic columns = input_row.DynamicSchema;&#xA;&#xA;int[] quotazioni={};&#xA;&#xA;int PMA_check = 0;&#xA;&#xA;for (int i = 0; i &lt; columns.getColumnCount(); i++)&#xA;{&#xA;DynamicMetadata columnMetadata = columns.getColumnMetadata(i);&#xA;String col_name=columnMetadata.getName();&#xA;&#xA;&#xA;if(col_name.equals(&quot;Nome&quot;)){&#xA;output_row.Nome = (String)columns.getColumnValue(i);&#xA;}&#xA;&#xA;&#xA;if(col_name.contains(&quot;PREZZO_&quot;)){&#xA;&#x9; /*System.out.println(&quot;Column Name = &quot; + col_name);&#xA;&#x9; System.out.println(&quot;Column Value = &quot; + columns.getColumnValue(i));*/&#xD;&#xA;&#x9;Integer col_value = Relational.ISNULL(columns.getColumnValue(i))? 0 : (Integer)columns.getColumnValue(i);&#xA;&#x9;quotazioni = fanta.addX(quotazioni.length, quotazioni, col_value);&#xA;}&#xA;&#xA;&#xA;if(col_name.contains(&quot;PMA&quot;) &amp;&amp; PMA_check == 0){&#xA;&#x9; //System.out.println(&quot;PMA VALUE = &quot; + (Integer)columns.getColumnValue(i));&#xA;&#x9; //System.out.println(&quot;Column Value = &quot; + columns.getColumnValue(i));&#xA;&#x9; Integer col_value = (Integer)columns.getColumnValue(i);&#xA;&#x9;quotazioni = fanta.addX(quotazioni.length, quotazioni, col_value);&#xA;&#x9;PMA_check = 1;&#xA;}&#xA;&#xA;&#xA;}&#xA;&#xA;&#xA;//System.out.println(&quot;ARRAY = &quot; + Arrays.toString(quotazioni));&#xA;&#xA;//riordino l'array&#xA;Arrays.sort(quotazioni);&#xA;&#xA;//creo un array di lavoro&#xA;int[] modifiedArray = Arrays.copyOfRange(quotazioni, 1, quotazioni.length);&#xA;&#xA;output_row.MAX = quotazioni[quotazioni.length-1];&#xA;output_row.MIN = quotazioni[0];&#xA;&#xA;&#xA;modifiedArray = quotazioni;&#xA;&#xA;//elimino i due valori più bassi&#xA;&#xA;&#xA;modifiedArray = Arrays.copyOfRange(modifiedArray, 2, quotazioni.length);&#xA;&#xA;//elimino i due valori più alti&#xA;modifiedArray = Arrays.copyOfRange(modifiedArray, 0, modifiedArray.length-2);&#xA;&#xA;quotazioni = modifiedArray;&#xA;&#xA;    double somma; int media; int cardin;&#xA;&#xA;    somma=0;&#xD;&#xA;    cardin = 0;&#xA;&#xA;    for(int i=0; i&lt;=quotazioni.length-1; i=i+1) {&#xA;    if (quotazioni[i] > 0){&#xA;    //System.out.println(input_row.Nome + &quot; => &quot; +quotazioni[i]);&#xA;      somma=somma+quotazioni[i];&#xD;&#xA;      cardin = cardin +1;&#xD;&#xA;    &#x9;}&#xA;    }&#xA;    &#xA;    &#xA;    &#xA;    &#xA;&#x9;//produco la media arrotondando il valore ottenuto&#xA;    media= (int) Math.round(somma/cardin);&#xA;    &#xA;    &#xA;    //System.out.println(&quot;SOMMA: &quot;+somma + &quot; | LENGTH: &quot; +   modifiedArray.length  + &quot;MEDIA:&quot; + media);&#xA;    &#xA;    &#xA;    &#xA;&#xA;&#xA;output_row.MEDIA_TRONCATA = media;&#xA;&#xA;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="import java.io.*; &#xA;import java.lang.*; &#xA;import java.util.*; "/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
