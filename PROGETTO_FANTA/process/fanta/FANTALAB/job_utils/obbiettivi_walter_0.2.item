    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select FASCIA,R,Nome,Squadra, TIT,SICU,INF, Note,MEDIA_TRONCATA, FMV, MV, 1 from&#xD;&#xA;fantalab.report_quot&#xD;&#xA;where R='D' and TIT >3 and (MV >=6  or MV=0)&#xD;&#xA;order by MEDIA_TRONCATA asc&quot;"/>
