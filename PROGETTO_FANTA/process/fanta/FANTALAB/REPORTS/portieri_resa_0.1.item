    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="//codice generato in accordo con schema di input e output&#xD;&#xA;output_row.ruolo = input_row.ruolo;&#xD;&#xA;output_row.nomeGiocatore = input_row.nomeGiocatore;&#xD;&#xA;output_row.squadra = input_row.squadra;&#xD;&#xA;output_row.voto = input_row.voto;&#xD;&#xA;output_row.votomodif = input_row.votomodif;&#xD;&#xA;&#xA;&#xA;if(!Relational.ISNULL(input_row.ruolo) &#xA;&amp;&amp;   (input_row.ruolo.equals(&quot;TETTENHAM&quot;) || input_row.ruolo.contains(&quot;PARAMETRI ZERO&quot;)&#xA; ||   input_row.ruolo.equals(&quot;FEL LAZIO&quot;) || input_row.ruolo.contains(&quot;800A&quot;)&#xA; ||   input_row.ruolo.equals(&quot;RITORNO AL CELIBATO&quot;) || input_row.ruolo.contains(&quot;AS IGNORANTI&quot;)&#xA; ||   input_row.ruolo.equals(&quot;ATLETICO MOGADISCIO&quot;) || input_row.ruolo.contains(&quot;LAUTARO SII O MI SIGNORE&quot;)&#xA; )&#xA; ){&#xA;&#xA;&#x9;&#x9;context.nome_squadra= input_row.ruolo;&#xA;&#x9;&#x9;System.out.println(&quot;ENTRO!&quot;);&#xA;}"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
      <column comment="" key="false" length="-1" name="ruolo" nullable="true" pattern="" precision="-1" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
