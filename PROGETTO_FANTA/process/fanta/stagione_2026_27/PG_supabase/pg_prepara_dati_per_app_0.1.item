    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;WITH dati AS (&#xD;&#xA;    SELECT&#xD;&#xA;        nome,&#xD;&#xA;        budget::numeric AS budget,&#xD;&#xA;        ROW_NUMBER() OVER (&#xD;&#xA;            PARTITION BY nome&#xD;&#xA;            ORDER BY budget::numeric&#xD;&#xA;        ) AS rn,&#xD;&#xA;        COUNT(*) OVER (&#xD;&#xA;            PARTITION BY nome&#xD;&#xA;        ) AS cnt&#xD;&#xA;    FROM public.strategieall&#xD;&#xA;    WHERE budget IS NOT NULL&#xD;&#xA;)&#xD;&#xA;SELECT&#xD;&#xA;    nome,&#xD;&#xA;    CASE&#xD;&#xA;        WHEN MAX(cnt) = 1 THEN NULL&#xD;&#xA;        ELSE GREATEST(&#xD;&#xA;            1,&#xD;&#xA;            ROUND(AVG(budget))&#xD;&#xA;        )::integer&#xD;&#xA;    END AS media_strategie&#xD;&#xA;FROM dati&#xD;&#xA;WHERE&#xD;&#xA;    rn > FLOOR(cnt / 4.0)&#xD;&#xA;    AND rn &lt;= cnt - FLOOR(cnt / 4.0)&#xD;&#xA;GROUP BY nome;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false" show="false"/>
