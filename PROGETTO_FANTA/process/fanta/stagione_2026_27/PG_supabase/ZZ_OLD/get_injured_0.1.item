  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="440" posY="80">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="CHECK" name="ACTIVATE" value="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="String html = input_row.string;&#xD;&#xA;&#xD;&#xA;int tableStart = html.indexOf(&quot;id=\&quot;infortunati_ufficiali\&quot;&quot;);&#xD;&#xA;int tbodyStart = html.indexOf(&quot;&lt;tbody>&quot;, tableStart);&#xD;&#xA;int tbodyEnd   = html.indexOf(&quot;&lt;/tbody>&quot;, tbodyStart);&#xD;&#xA;&#xD;&#xA;if (tableStart >= 0 &amp;&amp; tbodyStart >= 0 &amp;&amp; tbodyEnd >= 0) {&#xD;&#xA;    output_row.righe_html =&#xD;&#xA;        html.substring(tbodyStart + &quot;&lt;tbody>&quot;.length(), tbodyEnd);&#xD;&#xA;} else {&#xD;&#xA;    output_row.righe_html = null;&#xD;&#xA;}"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
      <column comment="" key="false" length="-1" name="righe_html" nullable="true" pattern="" precision="-1" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
    </metadata>
  </node>
