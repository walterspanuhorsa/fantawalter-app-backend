    <elementParameter field="DBTABLE" name="TABLE" value="&quot;&quot;"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;WITH fantalab AS (&#xD;&#xA;    SELECT DISTINCT&#xD;&#xA;        &quot;Nome&quot; AS nome_fantalab,&#xD;&#xA;        &quot;Squadra&quot; AS squadra,&#xD;&#xA;&#xD;&#xA;        regexp_replace(&#xD;&#xA;            trim(&quot;Nome&quot;),&#xD;&#xA;            '[[:space:]]+[[:alpha:]]+(\.[[:alpha:]]+)*\.$',&#xD;&#xA;            ''&#xD;&#xA;        ) AS cognome_base&#xD;&#xA;&#xD;&#xA;    FROM public.datifantacalcio&#xD;&#xA;    WHERE &quot;Nome&quot; IS NOT NULL&#xD;&#xA;      AND &quot;Squadra&quot; IS NOT NULL&#xD;&#xA;),&#xD;&#xA;candidati AS (&#xD;&#xA;    SELECT&#xD;&#xA;        f.fco_id,&#xD;&#xA;        d.nome_fantalab,&#xD;&#xA;&#xD;&#xA;        COUNT(*) OVER (&#xD;&#xA;            PARTITION BY f.fco_id&#xD;&#xA;        ) AS numero_candidati&#xD;&#xA;&#xD;&#xA;    FROM public.fco_players f&#xD;&#xA;&#xD;&#xA;    JOIN fantalab d&#xD;&#xA;      ON regexp_replace(&#xD;&#xA;             translate(&#xD;&#xA;                 upper(f.last_name),&#xD;&#xA;                 'ÀÁÂÃÄÈÉÊËÌÍÎÏÒÓÔÕÖÙÚÛÜÇÑ',&#xD;&#xA;                 'AAAAAEEEEIIIIOOOOOUUUUCN'&#xD;&#xA;             ),&#xD;&#xA;             '[^A-Z0-9]',&#xD;&#xA;             '',&#xD;&#xA;             'g'&#xD;&#xA;         )&#xD;&#xA;       =&#xD;&#xA;         regexp_replace(&#xD;&#xA;             translate(&#xD;&#xA;                 upper(d.cognome_base),&#xD;&#xA;                 'ÀÁÂÃÄÈÉÊËÌÍÎÏÒÓÔÕÖÙÚÛÜÇÑ',&#xD;&#xA;                 'AAAAAEEEEIIIIOOOOOUUUUCN'&#xD;&#xA;             ),&#xD;&#xA;             '[^A-Z0-9]',&#xD;&#xA;             '',&#xD;&#xA;             'g'&#xD;&#xA;         )&#xD;&#xA;&#xD;&#xA;     AND regexp_replace(&#xD;&#xA;             upper(f.team),&#xD;&#xA;             '[^A-Z0-9]',&#xD;&#xA;             '',&#xD;&#xA;             'g'&#xD;&#xA;         )&#xD;&#xA;       =&#xD;&#xA;         regexp_replace(&#xD;&#xA;             upper(d.squadra),&#xD;&#xA;             '[^A-Z0-9]',&#xD;&#xA;             '',&#xD;&#xA;             'g'&#xD;&#xA;         )&#xD;&#xA;&#xD;&#xA;    WHERE f.nome_fantalab IS NULL&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;UPDATE public.fco_players f&#xD;&#xA;SET nome_fantalab = c.nome_fantalab&#xD;&#xA;FROM candidati c&#xD;&#xA;WHERE f.fco_id = c.fco_id&#xD;&#xA;  AND c.numero_candidati = 1;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
