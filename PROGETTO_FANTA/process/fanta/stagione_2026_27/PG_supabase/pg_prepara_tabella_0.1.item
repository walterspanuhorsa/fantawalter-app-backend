    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="&#xD;&#xA;&#xD;&#xA;context.lista_strategie = &quot;media_strategie numeric(10,6) default null,&quot;;&#xD;&#xA;&#xD;&#xA;context.query_create_start = &quot;create table public.data_ready_for_app_&quot;+context.fantaType+&quot; (obiett varchar(2) default null, fascia varchar(30) default null, ruolo char(1) default null, team varchar(3) default null, nome varchar(50) default null, &quot;;&#xD;&#xA;&#xD;&#xA;context.query_create_end = &quot;pma numeric(4,2) default null, quo integer default null, titolarita integer default null, affidabilita integer default null, integrita integer default null, commento varchar(1024) default null, nota_1 varchar(50) default null, nota_2 varchar(50) default null, nota_3 varchar(50) default null, nota_4 varchar(50) default null, nota_5 varchar(50) default null, mv numeric(4,2) default null, fmv numeric(4,2) default null, presenze integer default null, fmv_exp numeric(4,2) default null, pt__tit integer default null, minuti integer default null, pt__inf integer default null, gol integer default null, assist integer default null, ammonizioni integer default null, espulsioni integer default null, rig__segnati integer default null, rig__sbagliati integer default null, gol_subiti integer default null, rig__parati integer default null)&quot;;&#xD;&#xA;&#xD;&#xA;"/>
