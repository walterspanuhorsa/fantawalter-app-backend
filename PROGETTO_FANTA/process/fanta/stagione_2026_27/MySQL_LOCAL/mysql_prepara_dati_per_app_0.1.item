    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT&#xD;&#xA;    Nome,&#xD;&#xA;    CAST(&#xD;&#xA;        ROUND(&#xD;&#xA;            (SUM(Budget) - MIN(Budget) - MAX(Budget))&#xD;&#xA;            / (COUNT(Budget) - 2),&#xD;&#xA;            2&#xD;&#xA;        ) AS DOUBLE&#xD;&#xA;    ) AS media_strategie&#xD;&#xA;FROM fantalab.strategieall&#xD;&#xA;WHERE Budget IS NOT NULL&#xD;&#xA;GROUP BY Nome&quot;"/>
