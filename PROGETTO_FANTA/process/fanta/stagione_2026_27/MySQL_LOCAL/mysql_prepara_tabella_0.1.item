  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="120" posY="240">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_2" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="context.lista_strategie = &quot;media_strategie &quot; + &quot; float(10,6) DEFAULT NULL,&quot;;&#xD;&#xA;&#xD;&#xA;context.query_create_start  = &quot;CREATE TABLE data_ready_for_app ( Obiett varchar(2) DEFAULT NULL, Fascia varchar(30) DEFAULT NULL, Ruolo char(1) DEFAULT NULL, Team varchar(3) DEFAULT NULL, Nome varchar(50) DEFAULT NULL, budget300 int(11) DEFAULT NULL, budget500 int(11) DEFAULT NULL, budget1000 int(11) DEFAULT NULL,&quot;;&#xD;&#xA;&#xD;&#xA;context.query_create_end =&quot;PMA decimal(4,2) DEFAULT NULL, Quo int(11) DEFAULT NULL, Titolarita int(11) DEFAULT NULL, Affidabilita int(11) DEFAULT NULL, Integrita int(11) DEFAULT NULL, Commento varchar(1024) DEFAULT NULL, Nota_1 varchar(50) DEFAULT NULL, Nota_2 varchar(50) DEFAULT NULL, Nota_3 varchar(50) DEFAULT NULL, Nota_4 varchar(50) DEFAULT NULL, Nota_5 varchar(50) DEFAULT NULL, MV decimal(4,2) DEFAULT NULL, FMV decimal(4,2) DEFAULT NULL, Presenze int(11) DEFAULT NULL, FMV_Exp decimal(4,2) DEFAULT NULL, Pt__Tit int(11) DEFAULT NULL, Minuti int(11) DEFAULT NULL, Pt__Inf int(11) DEFAULT NULL, Gol int(11) DEFAULT NULL, Assist int(11) DEFAULT NULL, Ammonizioni int(11) DEFAULT NULL, Espulsioni int(11) DEFAULT NULL, Rig__Segnati int(11) DEFAULT NULL, Rig__Sbagliati int(11) DEFAULT NULL, Gol_Subiti int(11) DEFAULT NULL, Rig__Parati int(11) DEFAULT NULL ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;&quot;;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_2"/>
  </node>
  <node componentName="tMysqlInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="120" posY="400">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBInput_1" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="MYSQL_8" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tDBConnection_1"/>
    <elementParameter field="TEXT" name="HOST" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="PORT" value="&quot;3306&quot;" show="false"/>
    <elementParameter field="TEXT" name="DBNAME" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="TYPE" value="MySQL" show="false"/>
    <elementParameter field="TEXT" name="USER" value="&quot;&quot;" show="false"/>
    <elementParameter field="PASSWORD" name="PASS" value="enc:system.encryption.key.v1:JzRqaMSHqG/63veygcBU8oT8hrFelaTRsgkxp05A" show="false"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;&quot;"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT DISTINCT&#xD;&#xA;    t.table_name&#xD;&#xA;FROM information_schema.tables t&#xD;&#xA;INNER JOIN information_schema.columns c&#xD;&#xA;    ON c.table_schema = t.table_schema&#xD;&#xA;   AND c.table_name = t.table_name&#xD;&#xA;WHERE t.table_schema = 'fantalab'&#xD;&#xA;  AND t.table_name REGEXP '^strategia_[A-Za-z0-9_]+$'&#xD;&#xA;  AND t.table_name &lt;> 'strategie_consolidate'&#xD;&#xA;  AND c.column_name = 'Budget'&#xD;&#xA;ORDER BY t.table_name&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false" show="false"/>
