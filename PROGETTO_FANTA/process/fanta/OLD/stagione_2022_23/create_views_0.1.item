  <node componentName="tMysqlRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="768" posY="224">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBRow_1" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="MYSQL_8" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tDBConnection_1"/>
    <elementParameter field="TEXT" name="HOST" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="PORT" value="&quot;3306&quot;" show="false"/>
    <elementParameter field="TEXT" name="DBNAME" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="TYPE" value="MSSQL" show="false"/>
    <elementParameter field="TEXT" name="USER" value="&quot;&quot;" show="false"/>
    <elementParameter field="PASSWORD" name="PASS" value="enc:system.encryption.key.v1:dEtSYAbfgJLVrMO3eAEuX40Ky+pbtCNxRTS0fo0F" show="false"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;&quot;"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;CREATE OR REPLACE&#xD;&#xA;ALGORITHM = UNDEFINED VIEW fanta.tren_giocatore AS (&#xD;&#xA;select&#xD;&#xA;    sg.Cod_ AS Cod_,&#xD;&#xA;    sg.nome AS nome,&#xD;&#xA;    sg.nome_squadra AS nome_squadra,&#xD;&#xA;    sg.ruolo AS ruolo,&#xD;&#xA;    sg.partite_giocate AS partite_giocate,&#xD;&#xA;    sg.media_voto AS media_voto,&#xD;&#xA;    sg.media_fantavoto AS media_fantavoto,&#xD;&#xA;    coalesce(u5.presenze, 0) AS presenzeU5,&#xD;&#xA;    round(coalesce(u5.voto_ultime_5, 0), 2) AS media_ultime_5,&#xD;&#xA;    round(coalesce(u5.voto_modif_ultime_5, 0), 2) AS media_fantavoto_ultime_5,&#xD;&#xA;    coalesce(u10.presenze, 0) AS presenzeU10,&#xD;&#xA;    round(coalesce(u10.voto_ultime_10, 0), 2) AS media_ultime_10,&#xD;&#xA;    round(coalesce(u10.voto_modif_ultime_10, 0), 2) AS media_fantavoto_ultime_10,&#xD;&#xA;    coalesce(gdr.presenze, 0) AS presenzeGDR,&#xD;&#xA;    round(coalesce(gdr.voto_ritorno,  0), 2) AS media_GDR,&#xD;&#xA;    round(coalesce(gdr.fantavoto_ritorno, 0), 2) AS media_fantavoto_GDR&#xD;&#xA;from&#xD;&#xA;    fanta.statistiche_generali sg&#xD;&#xA;left join fanta.ultime_5 u5 on u5.Cod_ = sg.Cod_&#xD;&#xA;left join fanta.ultime_10 u10 on u10.Cod_ = sg.Cod_&#xD;&#xA;left join fanta.girone_di_ritorno gdr on gdr.Cod_  = sg.Cod_&#xD;&#xA;group by&#xD;&#xA;    sg.Cod_&#xD;&#xA;order by&#xD;&#xA;    sg.nome_squadra,&#xD;&#xA;    sg.ruolo desc)&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false" show="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="false"/>
    <elementParameter field="TEXT" name="PROPERTIES" value="&quot;&quot;" show="false"/>
    <elementParameter field="CHECK" name="PROPAGATE_RECORD_SET" value="false"/>
    <elementParameter field="COLUMN_LIST" name="RECORD_SET_COLUMN" value="" show="false"/>
