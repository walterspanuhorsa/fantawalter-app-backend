    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;CREATE OR REPLACE&#xD;&#xA;ALGORITHM = UNDEFINED VIEW fanta.ultime_10 AS (&#xD;&#xA;select&#xD;&#xA;    sg.Cod_ AS Cod_,&#xD;&#xA;    sg.Nome AS Nome,&#xD;&#xA;    sg.nome_squadra AS nome_squadra,&#xD;&#xA;    sg.Ruolo AS ruolo,&#xD;&#xA;    count(1) AS presenze,&#xD;&#xA;    avg(sg.Voto) AS voto_ultime_10,&#xD;&#xA;    avg(sg.Voto_modificato) AS voto_modif_ultime_10&#xD;&#xA;from&#xD;&#xA;    fanta.voti_giocatori_giornata sg&#xD;&#xA;where&#xD;&#xA;    sg.giornata > (&#xD;&#xA;    select&#xD;&#xA;        max(sg2.giornata)&#xD;&#xA;    from&#xD;&#xA;        fanta.voti_giocatori_giornata sg2) - 10&#xD;&#xA;group by&#xD;&#xA;    sg.Cod_&#xD;&#xA;order by&#xD;&#xA;    sg.nome_squadra,&#xD;&#xA;    sg.Ruolo desc)&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false" show="false"/>
