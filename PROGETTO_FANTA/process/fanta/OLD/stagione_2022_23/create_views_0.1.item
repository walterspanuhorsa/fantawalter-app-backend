    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;CREATE OR REPLACE VIEW  INDICE_ATTENBILITA AS &#xD;&#xA;select gdr.Cod_, gdr.Nome, gdr.nome_squadra, gdr.ruolo,  &#xD;&#xA;CASE &#xD;&#xA;&#x9;WHEN gdr.ruolo = 'D' and gdr.presenze > 15 THEN ROUND(((sg.media_voto + gdr.voto_ritorno)/2) * 15 )&#xD;&#xA;&#x9;WHEN gdr.ruolo = 'D' and gdr.presenze &lt;15  THEN ROUND(((sg.media_fantavoto + gdr.voto_ritorno)/2) * gdr.presenze )&#xD;&#xA;&#x9;WHEN gdr.ruolo = 'C' and gdr.presenze >14  THEN ROUND(((sg.media_fantavoto + gdr.fantavoto_ritorno)/2)  * 13)&#xD;&#xA;&#x9;WHEN gdr.ruolo = 'C' and gdr.presenze &lt;14  THEN ROUND(((sg.media_fantavoto + gdr.fantavoto_ritorno)/2)  * presenze)&#xD;&#xA;&#x9;WHEN gdr.ruolo = 'A' and gdr.presenze >14  THEN ROUND(((sg.media_fantavoto + gdr.fantavoto_ritorno)/2)  * (13 *0.87))&#xD;&#xA;&#x9;WHEN gdr.ruolo = 'A' and gdr.presenze &lt;14  THEN ROUND(((sg.media_fantavoto + gdr.fantavoto_ritorno)/2)  * (presenze *0.72))&#xD;&#xA;END IA,&#xD;&#xA;sg.media_voto, sg.media_fantavoto, sg.partite_giocate as presenze_totali, ROUND(gdr.voto_ritorno,2) as voto_rit, ROUND(gdr.fantavoto_ritorno, 2) as fantavoto_rit, gdr.presenze presenze_ritorno &#xD;&#xA;from fanta.girone_di_ritorno gdr&#xD;&#xA;join fanta.statistiche_generali sg on sg.Cod_ = gdr.Cod_&#xD;&#xA;where gdr.ruolo='A'&#xD;&#xA;order by IA DESC&#xD;&#xA;from girone_di_ritorno gdr&#xD;&#xA;join statistiche_generali sg on sg.Cod_ = gdr.Cod_ &#xD;&#xA;order by IA DESC&#xD;&#xA;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false" show="false"/>
