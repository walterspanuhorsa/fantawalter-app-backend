  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="512" posY="128">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="//codice generato in accordo con schema di input e output&#xD;&#xA;output_row.ID = input_row.ID;&#xD;&#xA;output_row.Ruolo = input_row.Ruolo;&#xD;&#xA;output_row.Nome = input_row.Nome;&#xD;&#xA;output_row.Squadra = input_row.Squadra;&#xA;&#xA;&#xA;if (&quot;P&quot;.equals(input_row.Ruolo)){&#xA;output_row.IA =  (int)(input_row.Valore * 5.5);&#xA;} &#xA;if (&quot;D&quot;.equals(input_row.Ruolo)){&#xA;output_row.IA =  (int)(input_row.Valore * 4.95);&#xA;} &#xA;if (&quot;C&quot;.equals(input_row.Ruolo)){&#xA;output_row.IA =  (int)(input_row.Valore * 3.4138);&#xA;} &#xA;if (&quot;A&quot;.equals(input_row.Ruolo)){&#xA;output_row.IA =  (int)(input_row.Valore * 2.35715);&#xA;} &#xA;&#xD;&#xA;output_row.Valore = fanta.calcolaPrezzo(output_row.IA, input_row.Ruolo);&#xD;&#xA;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
      <column comment="" key="false" length="-1" name="ID" nullable="true" pattern="" precision="-1" sourceType="" type="id_Integer" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="2" name="Ruolo" nullable="true" pattern="" precision="-1" sourceType="" type="id_String" originalLength="2" usefulColumn="true"/>
      <column comment="" key="false" length="30" name="Nome" nullable="true" pattern="" precision="-1" sourceType="" type="id_String" originalLength="30" usefulColumn="true"/>
      <column comment="" key="false" length="20" name="Squadra" nullable="true" pattern="" precision="-1" sourceType="" type="id_String" originalLength="20" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="IA" nullable="true" pattern="" precision="-1" sourceType="" type="id_Integer" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="Valore" nullable="true" pattern="" precision="-1" sourceType="" type="id_Integer" originalLength="-1" usefulColumn="true"/>
    </metadata>
  </node>
