    <elementParameter field="MEMO_JAVA" name="CODE" value="//codice generato in accordo con schema di input e output&#xD;&#xA;output_row.ID = 1;&#xD;&#xA;output_row.Ruolo = input_row.Ruolo;&#xD;&#xA;output_row.Nome = input_row.Nome;&#xD;&#xA;output_row.Squadra = input_row.Squadra;&#xA;&#xA;&#xA;if (&quot;P&quot;.equals(input_row.Ruolo)){&#xA;output_row.IA =  (int)(input_row.Valore * 4.3044);&#xA;} &#xA;if (&quot;D&quot;.equals(input_row.Ruolo)){&#xA;output_row.IA =  (int)(input_row.Valore * 3.96);&#xA;} &#xA;if (&quot;C&quot;.equals(input_row.Ruolo)){&#xA;output_row.IA =  (int)(input_row.Valore * 3);&#xA;} &#xA;if (&quot;A&quot;.equals(input_row.Ruolo)){&#xA;output_row.IA =  (int)(input_row.Valore * 2.35715);&#xA;} &#xA;&#xD;&#xA;output_row.Valore = fanta.calcolaPrezzo(output_row.IA, input_row.Ruolo);&#xD;&#xA;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
