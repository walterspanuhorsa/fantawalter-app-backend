  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="448" posY="128">
    <elementParameter field="TEXT" name="UNIQUE_NAME" show="false" value="tJavaRow_1"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#13;&#10;&#10;/*output_row.Nome = input_row.Nome;&#13;&#10;output_row.gol = input_row.gol;&#13;&#10;output_row.gol_xp = input_row.assist;&#13;&#10;output_row.assist = input_row.assist;*/&#13;&#10;&#10;String str_nome = input_row.Nome;&#10;&#10;if (!Relational.ISNULL(str_nome)){&#10;&#10;String[] nomeGiocatore =  str_nome.split(&quot; &quot;);&#10;&#10;output_row.Nome = nomeGiocatore[nomeGiocatore.length - 1].toUpperCase();&#10;&#10;if (nomeGiocatore.length &gt; 1){&#10;&#10;output_row.Nome_opz2 =nomeGiocatore[nomeGiocatore.length - 1].toUpperCase() + &quot; &quot;+    nomeGiocatore[nomeGiocatore.length - 2].toUpperCase().substring(0,1)+ &quot;.&quot;;&#10;&#10;} else if (nomeGiocatore.length == 1){&#10;output_row.Nome_opz2 = output_row.Nome;&#10;&#10;}&#10;&#10;}&#10;&#10;&#10;String str = input_row.gol;&#10;if (!Relational.ISNULL(str)){&#10;&#9;if (str.contains(&quot;+&quot;)){&#10;&#9;&#9;String[] arrOfStr = str.split(&quot;\\+&quot;, 2);&#10;&#10;&#9;&#9;output_row.gol = arrOfStr[0];&#10;&#9;&#9;output_row.gol_xp = arrOfStr[1];&#10;&#10;&#10;&#9;} else if (str.contains(&quot;-&quot;)){&#10;&#9;&#9;String[] arrOfStr = str.split(&quot;-&quot;, 2);&#10;&#10;&#9;&#9;output_row.gol =  arrOfStr[0];&#10;&#9;&#9;output_row.gol_xp = &quot;-&quot; + arrOfStr[1];&#10;&#10;&#10;&#9;} else {&#10;&#9;&#9;output_row.gol =  input_row.gol;&#10;&#9;&#9;output_row.gol_xp = &quot;0&quot;;&#10;&#9;}&#10;}&#10;&#10;&#10;String str_as = input_row.assist;&#10;if (!Relational.ISNULL(str_as)){&#10;&#9;if (str_as.contains(&quot;+&quot;)){&#10;&#9;&#9;String[] arrOfStr_as = str_as.split(&quot;\\+&quot;, 2);&#10;&#10;&#9;&#9;output_row.assist = arrOfStr_as[0];&#10;&#9;&#9;output_row.assist_xp = arrOfStr_as[1];&#10;&#10;&#10;&#9;} else if (str_as.contains(&quot;-&quot;)){&#10;&#9;&#9;String[] arrOfStr_as = str_as.split(&quot;-&quot;, 2);&#10;&#10;&#9;&#9;output_row.assist =  arrOfStr_as[0];&#10;&#9;&#9;output_row.assist_xp = &quot;-&quot; + arrOfStr_as[1];&#10;&#10;&#10;&#9;} else {&#10;&#9;&#9;output_row.assist =  input_row.assist;&#10;&#9;&#9;output_row.assist_xp = &quot;0&quot;;&#10;&#9;}&#10;}&#10;&#10;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
