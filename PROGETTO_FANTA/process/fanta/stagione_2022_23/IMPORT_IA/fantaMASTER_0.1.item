    <elementParameter field="MEMO_JAVA" name="CODE" value="//codice generato in accordo con schema di input e output&#13;&#10;output_row.ID = 1;&#13;&#10;output_row.Ruolo = input_row.Ruolo;&#13;&#10;output_row.Nome = input_row.Nome;&#13;&#10;output_row.Squadra = input_row.Squadra;&#10;&#10;&#10;if (&quot;P&quot;.equals(input_row.Ruolo)){&#10;output_row.IA =  (int)(input_row.Valore * 4.3044);&#10;} &#10;if (&quot;D&quot;.equals(input_row.Ruolo)){&#10;output_row.IA =  (int)(input_row.Valore * 3.96);&#10;} &#10;if (&quot;C&quot;.equals(input_row.Ruolo)){&#10;output_row.IA =  (int)(input_row.Valore * 3);&#10;} &#10;if (&quot;A&quot;.equals(input_row.Ruolo)){&#10;output_row.IA =  (int)(input_row.Valore * 2.35715);&#10;} &#10;&#13;&#10;output_row.Valore = fanta.calcolaPrezzo(output_row.IA, input_row.Ruolo);&#13;&#10;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
