  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="512" posY="128">
    <elementParameter field="TEXT" name="UNIQUE_NAME" show="false" value="tJavaRow_1"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="//codice generato in accordo con schema di input e output&#13;&#10;output_row.ID = input_row.ID;&#13;&#10;output_row.Ruolo = input_row.Ruolo;&#13;&#10;output_row.Nome = input_row.Nome;&#13;&#10;output_row.Squadra = input_row.Squadra;&#10;&#10;&#10;if (&quot;P&quot;.equals(input_row.Ruolo)){&#10;output_row.IA =  (int)(input_row.Valore * 5.5);&#10;} &#10;if (&quot;D&quot;.equals(input_row.Ruolo)){&#10;output_row.IA =  (int)(input_row.Valore * 4.95);&#10;} &#10;if (&quot;C&quot;.equals(input_row.Ruolo)){&#10;output_row.IA =  (int)(input_row.Valore * 3.4138);&#10;} &#10;if (&quot;A&quot;.equals(input_row.Ruolo)){&#10;output_row.IA =  (int)(input_row.Valore * 2.35715);&#10;} &#10;&#13;&#10;output_row.Valore = fanta.calcolaPrezzo(output_row.IA, input_row.Ruolo);&#13;&#10;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
      <column comment="" key="false" length="-1" name="ID" nullable="true" originalLength="-1" pattern="" precision="-1" sourceType="" type="id_Integer" usefulColumn="true"/>
      <column comment="" key="false" length="2" name="Ruolo" nullable="true" originalLength="2" pattern="" precision="-1" sourceType="" type="id_String" usefulColumn="true"/>
