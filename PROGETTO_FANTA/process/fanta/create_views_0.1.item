    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;CREATE OR REPLACE VIEW  INDICE_ATTENBILITA AS &#13;&#10;select gdr.Cod_, gdr.Nome, gdr.nome_squadra, gdr.ruolo,  &#13;&#10;CASE &#13;&#10;&#9;WHEN gdr.ruolo = 'D' and gdr.presenze &gt; 15 THEN ROUND(((sg.media_voto + gdr.voto_ritorno)/2) * 15 )&#13;&#10;&#9;WHEN gdr.ruolo = 'D' and gdr.presenze &lt;15  THEN ROUND(((sg.media_fantavoto + gdr.voto_ritorno)/2) * gdr.presenze )&#13;&#10;&#9;WHEN gdr.ruolo = 'C' and gdr.presenze &gt;14  THEN ROUND(((sg.media_fantavoto + gdr.fantavoto_ritorno)/2)  * 13)&#13;&#10;&#9;WHEN gdr.ruolo = 'C' and gdr.presenze &lt;14  THEN ROUND(((sg.media_fantavoto + gdr.fantavoto_ritorno)/2)  * presenze)&#13;&#10;&#9;WHEN gdr.ruolo = 'A' and gdr.presenze &gt;14  THEN ROUND(((sg.media_fantavoto + gdr.fantavoto_ritorno)/2)  * (13 *0.87))&#13;&#10;&#9;WHEN gdr.ruolo = 'A' and gdr.presenze &lt;14  THEN ROUND(((sg.media_fantavoto + gdr.fantavoto_ritorno)/2)  * (presenze *0.72))&#13;&#10;END IA,&#13;&#10;sg.media_voto, sg.media_fantavoto, sg.partite_giocate as presenze_totali, ROUND(gdr.voto_ritorno,2) as voto_rit, ROUND(gdr.fantavoto_ritorno, 2) as fantavoto_rit, gdr.presenze presenze_ritorno &#13;&#10;from fanta.girone_di_ritorno gdr&#13;&#10;join fanta.statistiche_generali sg on sg.Cod_ = gdr.Cod_&#13;&#10;where gdr.ruolo='A'&#13;&#10;order by IA DESC&#13;&#10;from girone_di_ritorno gdr&#13;&#10;join statistiche_generali sg on sg.Cod_ = gdr.Cod_ &#13;&#10;order by IA DESC&#13;&#10;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" show="false" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" show="false" value="false"/>
