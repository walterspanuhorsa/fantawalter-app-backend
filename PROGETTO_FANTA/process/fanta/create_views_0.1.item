    <elementParameter field="TEXT" name="TYPE" show="false" value="MSSQL"/>
    <elementParameter field="TEXT" name="USER" show="false" value="&quot;&quot;"/>
    <elementParameter field="PASSWORD" name="PASS" show="false" value="enc:system.encryption.key.v1:dEtSYAbfgJLVrMO3eAEuX40Ky+pbtCNxRTS0fo0F"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;&quot;"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" show="false" value=""/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;CREATE OR REPLACE&#13;&#10;ALGORITHM = UNDEFINED VIEW fanta.tren_giocatore AS (&#13;&#10;select&#13;&#10;    sg.Cod_ AS Cod_,&#13;&#10;    sg.nome AS nome,&#13;&#10;    sg.nome_squadra AS nome_squadra,&#13;&#10;    sg.ruolo AS ruolo,&#13;&#10;    sg.partite_giocate AS partite_giocate,&#13;&#10;    sg.media_voto AS media_voto,&#13;&#10;    sg.media_fantavoto AS media_fantavoto,&#13;&#10;    coalesce(u5.presenze, 0) AS presenzeU5,&#13;&#10;    round(coalesce(u5.voto_ultime_5, 0), 2) AS media_ultime_5,&#13;&#10;    round(coalesce(u5.voto_modif_ultime_5, 0), 2) AS media_fantavoto_ultime_5,&#13;&#10;    coalesce(u10.presenze, 0) AS presenzeU10,&#13;&#10;    round(coalesce(u10.voto_ultime_10, 0), 2) AS media_ultime_10,&#13;&#10;    round(coalesce(u10.voto_modif_ultime_10, 0), 2) AS media_fantavoto_ultime_10,&#13;&#10;    coalesce(gdr.presenze, 0) AS presenzeGDR,&#13;&#10;    round(coalesce(gdr.voto_ritorno,  0), 2) AS media_GDR,&#13;&#10;    round(coalesce(gdr.fantavoto_ritorno, 0), 2) AS media_fantavoto_GDR&#13;&#10;from&#13;&#10;    fanta.statistiche_generali sg&#13;&#10;left join fanta.ultime_5 u5 on u5.Cod_ = sg.Cod_&#13;&#10;left join fanta.ultime_10 u10 on u10.Cod_ = sg.Cod_&#13;&#10;left join fanta.girone_di_ritorno gdr on gdr.Cod_  = sg.Cod_&#13;&#10;group by&#13;&#10;    sg.Cod_&#13;&#10;order by&#13;&#10;    sg.nome_squadra,&#13;&#10;    sg.ruolo desc)&quot;"/>
    <elementParameter field="LABEL" name="NOTE" show="false" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" show="false" value="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" show="false" value="&quot;&quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="false"/>
    <elementParameter field="TEXT" name="PROPERTIES" show="false" value="&quot;&quot;"/>
    <elementParameter field="CHECK" name="PROPAGATE_RECORD_SET" value="false"/>
