    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;CREATE OR REPLACE&#13;&#10;ALGORITHM = UNDEFINED VIEW fanta.ultime_5 AS (&#13;&#10;select&#13;&#10;    sg.Cod_ AS Cod_,&#13;&#10;    sg.Nome AS Nome,&#13;&#10;    sg.nome_squadra AS nome_squadra,&#13;&#10;    sg.Ruolo AS ruolo,&#13;&#10;    count(1) AS presenze,&#13;&#10;    avg(sg.Voto) AS voto_ultime_5,&#13;&#10;    avg(sg.Voto_modificato) AS voto_modif_ultime_5&#13;&#10;from&#13;&#10;    fanta.voti_giocatori_giornata sg&#13;&#10;where&#13;&#10;    sg.giornata &gt; (&#13;&#10;    select&#13;&#10;        max(sg2.giornata)&#13;&#10;    from&#13;&#10;        fanta.voti_giocatori_giornata sg2) - 5&#13;&#10;group by&#13;&#10;    sg.Cod_&#13;&#10;order by&#13;&#10;    sg.nome_squadra,&#13;&#10;    sg.Ruolo desc)&quot;"/>
    <elementParameter field="LABEL" name="NOTE" show="false" value="This option only applies when deploying and running in the Talend Runtime"/>
