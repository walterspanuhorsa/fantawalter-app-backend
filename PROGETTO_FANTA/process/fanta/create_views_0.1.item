    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;CREATE OR REPLACE VIEW fanta.girone_di_ritorno  AS &#13;&#10;select sg.Cod_ AS Cod_,sg.Nome AS Nome,sg.nome_squadra AS nome_squadra,sg.Ruolo AS ruolo,count(1) AS presenze,avg(sg.Voto) AS voto_ritorno,avg(sg.Voto_modificato) AS fantavoto_ritorno &#13;&#10;from fanta.voti_giocatori_giornata sg &#13;&#10;where sg.giornata &gt; 18 group by sg.Cod_ order by sg.nome_squadra,sg.Ruolo desc &quot;"/>
