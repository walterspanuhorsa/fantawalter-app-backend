    <elementParameter field="MEMO_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#xD;&#xA;output_row.Cod_ = input_row.Cod_;&#xD;&#xA;output_row.Nome = input_row.Nome;&#xD;&#xA;output_row.nome_squadra = input_row.nome_squadra;&#xD;&#xA;output_row.ruolo = input_row.ruolo;&#xD;&#xA;output_row.IA = input_row.IA;&#xD;&#xA;output_row.modif_voto = input_row.modif_voto;&#xD;&#xA;output_row.presenze = input_row.presenze;&#xD;&#xA;output_row.max_val = input_row.presenze;&#xD;&#xA;&#xA;Integer counter = Numeric.sequence(&quot;contatore&quot;, 0, 1);&#xA;&#xA;output_row.max_val = fanta.getMaxVal(input_row.IA, counter);"/>
