    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select FCit.id, FCit.R, FCit.Nome, FCit.Squadra, &#13;&#10;FCit.FVM  as FVM_FCit,&#13;&#10;FCit.FVM_CALCOLATO as FVMC_FCit,&#13;&#10;club.FVM_CALCOLATO as FVMC_Club,&#13;&#10;pf.FVM_CALCOLATO  as FVMC_Pf,&#13;&#10;Fm.FVM_CALCOLATO as FVMC_Fm,&#13;&#10;gds.FVM_CALCOLATO  as FVMC_Gds,&#13;&#10;fs.FVM_CALCOLATO  as FVMC_Fs,&#13;&#10;pazz.FVM_CALCOLATO  as FVMC_Pazz,&#13;&#10;FCit.Qt_A  as QTA_FCit, &#13;&#10;club.Qt_A  as QTA_Club, &#13;&#10;pf.Qt_A as QTA_Pf,&#13;&#10;fm.Qt_A  as QTA_Fm,&#13;&#10;gds.Qt_A  as QTA_gds,&#13;&#10;fs.QT_A as QTA_Fs,&#13;&#10;pazz.QT_A as QTA_Pazz&#13;&#10;from fanta.listone_fantacalcioit_202324 FCit&#13;&#10;left join fanta.listone_fantaclub_202324 club &#13;&#10;&#9;on club.id = FCit.id&#13;&#10;left join fanta.listone_gds_202324 gds &#13;&#10;&#9;on gds.id = FCit.id&#13;&#10;left join fanta.listone_fantamaster_202324 Fm   &#13;&#10;&#9;on Fm.id = FCit.id&#13;&#10;left join listone_PianetaFanta_202324 pf &#13;&#10;&#9;on Pf.id = fcit.id&#13;&#10;left join listone_fantaSoccer_202324 fs &#13;&#10;&#9;on fs.id = fcit.id&#13;&#10;left join listone_fantaPazz_202324 pazz &#13;&#10;&#9;on pazz.id = fcit.id&#13;&#10;where FCit.POSIZIONE is not null and FCit.R &lt;&gt;'P'&#13;&#10;order by FCit.POSIZIONE  asc&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" show="false" value="&quot;&quot;"/>
    <elementParameter field="MAPPING_TYPE" name="MAPPING" show="false" value="mysql_id"/>
    <elementParameter field="TEXT" name="PROPERTIES" value="&quot;noDatetimeStringSync=true&amp;enabledTLSProtocols=TLSv1.2,TLSv1.1,TLSv1&quot;"/>
