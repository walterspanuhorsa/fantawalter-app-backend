    <elementParameter field="MEMO_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#xA;&#xA;//System.out.println(input_row.Nome +&quot; => &quot;+ input_row.FVM_FCit + &quot; &quot; + input_row.FVMC_FCit  + &quot; &quot; + input_row.FVMC_Club + &quot; &quot; +input_row.FVMC_Gds + &quot; &quot; + input_row.FVMC_Fm + &quot; &quot; +input_row.FVMC_Pf);&#xA;&#xA;Integer FVMC_FCit = Relational.ISNULL(input_row.FVMC_FCit)? input_row.FVM_FCit :  input_row.FVMC_FCit;&#xA;Integer FVMC_Club = Relational.ISNULL(input_row.FVMC_Club)? input_row.FVM_FCit :  input_row.FVMC_Club;&#xA;Integer FVMC_Gds = Relational.ISNULL(input_row.FVMC_Gds)? input_row.FVM_FCit :  input_row.FVMC_Gds;&#xA;Integer FVMC_Fm = Relational.ISNULL(input_row.FVMC_Fm)? input_row.FVM_FCit :  input_row.FVMC_Fm;&#xA;Integer FVMC_Pf = Relational.ISNULL(input_row.FVMC_Pf)? input_row.FVM_FCit :  input_row.FVMC_Pf;&#xA;Integer FVMC_Fs = Relational.ISNULL(input_row.FVMC_Fs)? input_row.FVM_FCit :  input_row.FVMC_Fs;&#xA;Integer FVMC_Pazz = Relational.ISNULL(input_row.FVMC_Pazz)? input_row.FVM_FCit :  input_row.FVMC_Pazz;&#xA;&#xA;&#xA;Integer Carmy_Prezzo = Relational.ISNULL(input_row.Carmy_Prezzo)? input_row.FVM_FCit :  input_row.Carmy_Prezzo;&#xA;Integer LEGHE_GE = Relational.ISNULL(input_row.FVM_GE)? input_row.FVM_FCit :  input_row.FVM_GE;&#xA;Integer LEGHE_FL = Relational.ISNULL(input_row.MEDIE_LEGHE)? input_row.FVM_FCit :  input_row.MEDIE_LEGHE;&#xA;&#xA;Integer FVM_FCit  = input_row.FVM_FCit;&#xA;&#xA;FVMC_FCit = fanta.returnFMVC(input_row.FVM_FCit , FVMC_FCit);&#xA;FVMC_Club = fanta.returnFMVC(input_row.FVM_FCit , FVMC_Club);&#xA;FVMC_Gds = fanta.returnFMVC(input_row.FVM_FCit ,  FVMC_Gds);&#xA;FVMC_Fm = fanta.returnFMVC(input_row.FVM_FCit , FVMC_Fm);&#xA;FVMC_Pf = fanta.returnFMVC(input_row.FVM_FCit , FVMC_Pf);&#xA;FVMC_Fs = fanta.returnFMVC(input_row.FVM_FCit , FVMC_Fs);&#xA;FVMC_Pazz = fanta.returnFMVC(input_row.FVM_FCit , FVMC_Pazz);&#xA;&#xA;LEGHE_GE = fanta.returnFMVC(input_row.FVM_FCit , LEGHE_GE);&#xA;LEGHE_FL = fanta.returnFMVC(input_row.FVM_FCit , LEGHE_FL);&#xA;Carmy_Prezzo = fanta.returnFMVC(input_row.FVM_FCit , Carmy_Prezzo);&#xA;&#xA;&#xA;//System.out.println(input_row.Nome +&quot; => &quot;+ FVM_FCit + &quot; &quot; + FVMC_FCit  + &quot; &quot; + FVMC_Club + &quot; &quot; +FVMC_Gds + &quot; &quot; + FVMC_Fm + &quot; &quot; +FVMC_Pf);&#xA;&#xA;Integer[] quotazioni= {FVM_FCit, FVMC_FCit, FVMC_Club, FVMC_Gds, FVMC_Fm,FVMC_Pf,FVMC_Fs,FVMC_Pazz, LEGHE_GE, LEGHE_FL, Carmy_Prezzo };&#xA;&#xA;&#xA;Arrays.sort(quotazioni);&#xA;&#xA;Integer[] modifiedArray = Arrays.copyOfRange(quotazioni, 1, quotazioni.length);&#xA;&#xA;&#xA;//elimino il valore più basso&#xA;modifiedArray = Arrays.copyOfRange(quotazioni, 1, quotazioni.length);&#xA;modifiedArray = Arrays.copyOfRange(quotazioni, 1, quotazioni.length);&#xA;&#xA;//elimino il valore più alto&#xA;modifiedArray = Arrays.copyOfRange(modifiedArray, 0, modifiedArray.length-1);&#xA;modifiedArray = Arrays.copyOfRange(modifiedArray, 0, modifiedArray.length-1);&#xA;&#xA;quotazioni = modifiedArray;&#xA;&#xA;    double somma; int media;&#xA;&#xA;    somma=0;&#xA;&#xA;    for(int i=0; i&lt;=quotazioni.length-1; i=i+1) {&#xA;    &#xA;    //System.out.println(input_row.Nome + &quot; => &quot; +quotazioni[i]);&#xA;      somma=somma+quotazioni[i];&#xA;    }&#xA;&#xA;    media= (int) Math.round(somma/quotazioni.length);&#xA;&#xA;&#xA;&#xD;&#xA;output_row.id = input_row.id;&#xA;output_row.R = input_row.R;&#xD;&#xA;output_row.Nome = input_row.Nome;&#xD;&#xA;output_row.Squadra = input_row.Squadra;&#xA;&#xD;&#xA;output_row.MEDIA_TRONCATA = media;&#xA;output_row.FVM_FCit =FVM_FCit;&#xA;output_row.LEGHE_GE = LEGHE_GE;&#xA;output_row.LEGHE_FL = LEGHE_FL;&#xA;output_row.Carmy_Prezzo = Carmy_Prezzo;&#xA;&#xA;output_row.giocate = input_row.giocate;&#xA;output_row.mediavoto = input_row.mediavoto;&#xA;output_row.fantamedia = input_row.fantamedia;&#xA;&#xA;&#xA;output_row.TIT = input_row.TIT;&#xA;output_row.SICU = input_row.SICU;&#xA;output_row.INF = input_row.INF;&#xA;output_row.Note = input_row.Note;&#xA;&#xA;output_row.FASCIA = null;&#xA;output_row.POSIZIONE = null;&#xA;&#xD;&#xA;output_row.FVMC_FCit  =  input_row.FVMC_FCit;&#xA;output_row.FVMC_Club  =  input_row.FVMC_Club;&#xA;output_row.FVMC_Gds   =  input_row.FVMC_Gds;&#xA;output_row.FVMC_Fm    =  input_row.FVMC_Fm;&#xA;output_row.FVMC_Pf    =  input_row.FVMC_Pf;&#xA;output_row.FVMC_Fs    =  input_row.FVMC_Fs;&#xA;output_row.FVMC_Pazz  =  input_row.FVMC_Pazz;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="import java.util.Arrays;"/>
