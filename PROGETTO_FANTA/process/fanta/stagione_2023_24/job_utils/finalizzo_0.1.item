    <elementParameter field="MEMO_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#10;&#10;//System.out.println(input_row.Nome +&quot; =&gt; &quot;+ input_row.FVM_FCit + &quot; &quot; + input_row.FVMC_FCit  + &quot; &quot; + input_row.FVMC_Club + &quot; &quot; +input_row.FVMC_Gds + &quot; &quot; + input_row.FVMC_Fm + &quot; &quot; +input_row.FVMC_Pf);&#10;&#10;Integer FVMC_FCit = Relational.ISNULL(input_row.FVMC_FCit)? input_row.FVM_FCit :  input_row.FVMC_FCit;&#10;Integer FVMC_Club = Relational.ISNULL(input_row.FVMC_Club)? input_row.FVM_FCit :  input_row.FVMC_Club;&#10;Integer FVMC_Gds = Relational.ISNULL(input_row.FVMC_Gds)? input_row.FVM_FCit :  input_row.FVMC_Gds;&#10;Integer FVMC_Fm = Relational.ISNULL(input_row.FVMC_Fm)? input_row.FVM_FCit :  input_row.FVMC_Fm;&#10;Integer FVMC_Pf = Relational.ISNULL(input_row.FVMC_Pf)? input_row.FVM_FCit :  input_row.FVMC_Pf;&#10;Integer FVMC_Fs = Relational.ISNULL(input_row.FVMC_Fs)? input_row.FVM_FCit :  input_row.FVMC_Fs;&#10;Integer FVMC_Pazz = Relational.ISNULL(input_row.FVMC_Pazz)? input_row.FVM_FCit :  input_row.FVMC_Pazz;&#10;Integer FVM_FCit  = input_row.FVM_FCit;&#10;&#10;FVMC_FCit = fanta.returnFMVC(input_row.FVM_FCit , FVMC_FCit);&#10;FVMC_Club = fanta.returnFMVC(input_row.FVM_FCit , FVMC_Club);&#10;FVMC_Gds = fanta.returnFMVC(input_row.FVM_FCit ,  FVMC_Gds);&#10;FVMC_Fm = fanta.returnFMVC(input_row.FVM_FCit , FVMC_Fm);&#10;FVMC_Pf = fanta.returnFMVC(input_row.FVM_FCit , FVMC_Pf);&#10;FVMC_Fs = fanta.returnFMVC(input_row.FVM_FCit , FVMC_Fs);&#10;FVMC_Pazz = fanta.returnFMVC(input_row.FVM_FCit , FVMC_Pazz);&#10;&#10;//System.out.println(input_row.Nome +&quot; =&gt; &quot;+ FVM_FCit + &quot; &quot; + FVMC_FCit  + &quot; &quot; + FVMC_Club + &quot; &quot; +FVMC_Gds + &quot; &quot; + FVMC_Fm + &quot; &quot; +FVMC_Pf);&#10;&#10;Integer[] quotazioni= {FVM_FCit, FVMC_FCit, FVMC_Club, FVMC_Gds, FVMC_Fm,FVMC_Pf,FVMC_Fs,FVMC_Pazz };&#10;&#10;&#10;Arrays.sort(quotazioni);&#10;&#10;Integer[] modifiedArray = Arrays.copyOfRange(quotazioni, 1, quotazioni.length);&#10;&#10;&#10;&#10;modifiedArray = Arrays.copyOfRange(quotazioni, 1, quotazioni.length);&#10;&#10;modifiedArray = Arrays.copyOfRange(modifiedArray, 0, modifiedArray.length-1);&#10;&#10;quotazioni = modifiedArray;&#10;&#10;    double somma; int media;&#10;&#10;    somma=0;&#10;&#10;    for(int i=0; i&lt;=quotazioni.length-1; i=i+1) {&#10;    &#10;    //System.out.println(input_row.Nome + &quot; =&gt; &quot; +quotazioni[i]);&#10;      somma=somma+quotazioni[i];&#10;    }&#10;&#10;    media= (int) Math.round(somma/quotazioni.length);&#10;&#10;&#10;output_row.MEDIA_TRONCATA = media;&#13;&#10;output_row.id = input_row.id;&#13;&#10;output_row.R = input_row.R;&#13;&#10;output_row.Nome = input_row.Nome;&#13;&#10;output_row.Squadra = input_row.Squadra;&#13;&#10;&#10;output_row.QTA_FCit = input_row.QTA_FCit;&#13;&#10;output_row.QTA_Club = input_row.QTA_Club;&#13;&#10;output_row.QTA_Gds = input_row.QTA_Gds;&#13;&#10;output_row.QTA_Fm = input_row.QTA_Fm;&#10;output_row.QTA_Pf = input_row.QTA_Pf;&#10;output_row.QTA_Fs = input_row.QTA_Fs;&#10;output_row.QTA_Pazz = input_row.QTA_Pazz;&#10;&#13;&#10;output_row.FVM_FCit = input_row.FVM_FCit;&#13;&#10;output_row.FVMC_FCit = input_row.FVMC_FCit;&#13;&#10;output_row.FVMC_Club = input_row.FVMC_Club;&#13;&#10;output_row.FVMC_Gds = input_row.FVMC_Gds;&#13;&#10;output_row.FVMC_Fm = input_row.FVMC_Fm;&#10;output_row.FVMC_Pf = input_row.FVMC_Pf;&#10;output_row.FVMC_Fs = input_row.FVMC_Fs;&#10;output_row.FVMC_Pazz = input_row.FVMC_Pazz;&#10;&#10;&#10;&#10;output_row.FASCIA = null;&#10;output_row.POSIZIONE = null;&#10;&#13;&#10;"/>
