    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select distinct FCit.id, FCit.R RUOLO,&#xD;&#xA;FCit.Nome, FCit.Squadra, &#xD;&#xA;case when stat.Pv is null then 0 else stat.Pv end  giocate,&#xD;&#xA;case when stat.Mv is null then 0 else stat.Mv end  mediavoto,&#xD;&#xA;case when stat.Fm is null then 0 else stat.Fm end  fantamedia,&#xD;&#xA;lc.Tit,&#xD;&#xA;lc.SICU,&#xD;&#xA;lc.INF,&#xD;&#xA;FCit.FVM_CALCOLATO as FVMC_FCit,&#xD;&#xA;club.FVM_CALCOLATO as FVMC_Club,&#xD;&#xA;pf.FVM_CALCOLATO  as FVMC_Pf,&#xD;&#xA;Fm.FVM_CALCOLATO as FVMC_Fm,&#xD;&#xA;gds.FVM_CALCOLATO  as FVMC_Gds,&#xD;&#xA;fs.FVM_CALCOLATO  as FVMC_Fs,&#xD;&#xA;pazz.FVM_CALCOLATO  as FVMC_Pazz,&#xD;&#xA;lc.Carmy_Prezzo,&#xD;&#xA;FCit.FVM  as FVM_FCit,&#xD;&#xA;ge.FVM as FVM_GE,&#xD;&#xA;lc.media_leghe MEDIE_LEGHE,&#xD;&#xA;lc.Note&#xD;&#xA;from fanta.listone_fantacalcioit_202324 FCit&#xD;&#xA;left join fanta.statistiche_giocatori_202324 stat &#xD;&#xA;&#x9;on stat.id = FCit.id&#xD;&#xA;left join fanta.listone_fantaclub_202324 club &#xD;&#xA;&#x9;on club.id = FCit.id&#xD;&#xA;left join fanta.listone_gds_202324 gds &#xD;&#xA;&#x9;on gds.id = FCit.id&#xD;&#xA;left join fanta.listone_fantamaster_202324 Fm   &#xD;&#xA;&#x9;on Fm.id = FCit.id&#xD;&#xA;left join listone_PianetaFanta_202324 pf &#xD;&#xA;&#x9;on Pf.id = fcit.id&#xD;&#xA;left join listone_fantaSoccer_202324 fs &#xD;&#xA;&#x9;on fs.id = fcit.id&#xD;&#xA;left join listone_fantaPazz_202324 pazz &#xD;&#xA;&#x9;on pazz.id = fcit.id&#xD;&#xA;left join listone_medieaste_202324 ge&#xD;&#xA;&#x9;on ge.id = fcit.id&#xD;&#xA;left join listone_carmy_202324 lc &#xD;&#xA;&#x9;on lc.id =fcit.id&#xD;&#xA;where FCit.POSIZIONE is not null and FCit.R &lt;>'P'&#xD;&#xA;order by FCit.POSIZIONE  asc&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
