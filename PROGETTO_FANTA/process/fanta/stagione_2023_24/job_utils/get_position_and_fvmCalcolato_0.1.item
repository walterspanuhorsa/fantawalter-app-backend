  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="608" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" show="false" value="tJavaRow_1"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#10;&#10;&#10;output_row.Id = input_row.Id;&#10;&#10;context.counter = context.counter +1;&#10;&#10;&#10;&#10;if (input_row.value &lt; context.value_prev || context.counter == 1){&#10;&#13;&#10;//System.out.println (&quot;ENTRO NELL'IF&quot;);&#10;&#13;&#10;output_row.POSIZIONE = context.counter;&#10;context.pos_prev = context.counter;&#10;&#10;} else {&#10;//&#9;System.out.println (&quot;ENTRO NELL'ELSE&quot;);&#10;&#9;output_row.POSIZIONE = context.pos_prev;&#9;&#10;}&#10;&#10;context.value_prev = input_row.value;&#13;&#10;&#10;System.out.println (input_row.Id + &quot; =&gt; attuale valore:&quot;+ input_row.value +&quot; | prev_value:&quot;+  context.value_prev + &quot; | POS: &quot; + output_row.POSIZIONE);"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
      <column comment="" key="false" length="-1" name="Id" nullable="true" originalLength="-1" pattern="" precision="-1" sourceType="INT" type="id_Integer" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="POSIZIONE" nullable="true" originalLength="-1" pattern="" precision="-1" sourceType="INT" type="id_Integer" usefulColumn="true"/>
    </metadata>
  </node>
