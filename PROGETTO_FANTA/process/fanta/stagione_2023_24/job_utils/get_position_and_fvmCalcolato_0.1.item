    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select  id, &#13;&#10;case when&#13;&#10;     POSIZIONE  &gt;= 1 and POSIZIONE  &lt;= 3   then Round(Qt_A* (4.9 -(POSIZIONE-1)*0.2))&#13;&#10;when POSIZIONE  &gt;= 4 and POSIZIONE  &lt;= 6   then Round(Qt_A*(4.8 -(POSIZIONE-4)*0.2)) &#13;&#10;when POSIZIONE  &gt;= 7 and POSIZIONE  &lt;= 9   then Round(Qt_A*(4.3 -(POSIZIONE-7)*0.2))&#13;&#10;when POSIZIONE  &gt;= 10 and POSIZIONE  &lt;= 24 then Round(Qt_A*(4 -(POSIZIONE-10)*0.2))&#13;&#10;when POSIZIONE  &gt;= 25  then Round(Qt_A*1.1)&#13;&#10;end FVM_CALCOLATO,&#13;&#10; case &#13;&#10;when POSIZIONE  &gt;= 1 and POSIZIONE   &lt;= 8    then 'TOP'&#13;&#10;when POSIZIONE  &gt;= 9 and POSIZIONE   &lt;= 16   then 'SEMITOP' &#13;&#10;when POSIZIONE  &gt;= 17 and POSIZIONE  &lt;= 24   then 'TERZA FASCIA'&#13;&#10;when POSIZIONE  &gt;= 25 and POSIZIONE  &lt;= 32   then 'QUARTA FASCIA'&#13;&#10;when POSIZIONE  &gt;= 33 and POSIZIONE  &lt;= 40   then 'QUINTA FASCIA' &#13;&#10;when POSIZIONE  &gt;= 41 and POSIZIONE  &lt;= 49   then 'SESTA FASCIA'&#13;&#10;end FASCIA&#13;&#10;from &quot;+ context.table_name+ &quot;&#13;&#10;where R = 'A' &#13;&#10;order by POSIZIONE  ASC&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
