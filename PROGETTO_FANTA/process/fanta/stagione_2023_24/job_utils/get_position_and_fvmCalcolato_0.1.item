    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select id, &#13;&#10;case when&#13;&#10;     POSIZIONE  &gt;= 1 and POSIZIONE  &lt;= 5   then Round(Qt_A*2 - ((POSIZIONE-1)*0.006))&#13;&#10;when POSIZIONE  &gt;= 6 and POSIZIONE  &lt;= 24   then Round(Qt_A*1.8 - ((POSIZIONE-6)*0.006)) &#13;&#10;when POSIZIONE  &gt;= 25 and POSIZIONE  &lt;= 42 then Round(Qt_A*1.6 - ((POSIZIONE-25)*0.006))&#13;&#10;when POSIZIONE  &gt;= 43  then Round(Qt_A*1.1- ((POSIZIONE-43)*0.012))&#13;&#10;end FVM_CALCOLATO,&#13;&#10; case &#13;&#10;when POSIZIONE  &gt;= 1 and POSIZIONE   &lt;= 5    then 'TOP'&#13;&#10;when POSIZIONE  &gt;= 6 and POSIZIONE   &lt;= 24   then 'SEMITOP' &#13;&#10;when POSIZIONE  &gt;= 25 and POSIZIONE  &lt;= 40   then 'TERZA FASCIA'&#13;&#10;when POSIZIONE  &gt;= 41 and POSIZIONE  &lt;= 49   then 'SCOMMESSE'&#13;&#10;end FASCIA&#13;&#10;from &quot;+context.table_name+&quot; &#13;&#10;WHERE R='C'&quot;"/>
