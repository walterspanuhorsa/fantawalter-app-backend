    <elementParameter field="MEMO_JAVA" name="CODE" value="//System.out.println(input_row.Nome);&#xA;&#xA;String Name = input_row.Nome;&#xA;Name = Name.toLowerCase();&#xA;String newName =&quot;&quot;;&#xA;&#xA;    &#x9;String[] splited = Name.split(&quot;\\s+&quot;);&#xA;    &#x9;&#xA;    for (int i = 0; i &lt; splited.length; i++){&#xA;    &#x9;&#xA;    &#x9;newName += splited[i].substring(0, 1).toUpperCase() + splited[i].substring(1) + &quot; &quot;;&#xA;    &#x9;}&#xA;&#xA;&#xA;newName = newName.substring(0, newName.length() - 1);&#xA;&#xA;//System.out.println(Name);&#xA;&#xA;&#xA;output_row.Nome = newName;&#xA;&#xA;//output_row.Nome = fanta.returnNameGds(newName, input_row.R) ;&#xA;&#xA;String NomeSquadra = input_row.Squadra.toLowerCase();&#xA;&#xA;&#xA;//Code generated according to input schema and output schema&#xD;&#xA;output_row.Id = input_row.Id;&#xD;&#xA;&#xD;&#xA;output_row.R = input_row.R;&#xD;&#xA;output_row.R2 = input_row.R2;&#xD;&#xA;output_row.Squadra = NomeSquadra.substring(0, 1).toUpperCase() + NomeSquadra.substring(1);&#xD;&#xA;&#xD;&#xA;output_row.Qt_A = (int)(input_row.Qt_A/2 -(input_row.Qt_A*0.06)); &#xD;&#xA;output_row.bonusmalus = input_row.bonusmalus;&#xD;&#xA;"/>
