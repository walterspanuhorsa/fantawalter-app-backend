    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#xA;&#xA;//System.out.println(input_row.Nome);&#xA;&#xA;&#xA;&#x9;&#xA;    &#x9;&#xA;&#xA;&#xA;String newName = input_row.Cognome + &quot; &quot; + input_row.Nome;&#xA;&#xA;&#xA;&#xA;    &#x9;&#xA;    &#x9;&#xA;&#xA;&#xA;output_row.Nome = newName;&#xA;&#xA;&#xD;&#xA;output_row.Id = input_row.Id;&#xD;&#xA;output_row.CognomeOriginale = input_row.Cognome;&#xA;output_row.NomeOriginale = input_row.Nome;&#xD;&#xA;&#xD;&#xA;output_row.Squadra = input_row.Squadra;&#xD;&#xA;output_row.R = input_row.R;&#xD;&#xA;output_row.Giornata = input_row.Giornata;&#xD;&#xA;output_row.Qt_A = (int)(input_row.Qt_A  -(input_row.Qt_A *0.2)) ;&#xD;&#xA;&#xA;&#xA;String[] splited = input_row.Cognome.split(&quot;\\s+&quot;);&#xA;    &#x9;&#xA;output_row.secondoCognome = (splited.length == 2) ?  splited[1] : &quot;ZZZZZZZZZZ&quot;;&#xA;&#xA;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
