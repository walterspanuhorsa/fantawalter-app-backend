    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select  id, &#xD;&#xA;case when&#xD;&#xA;     POSIZIONE  >= 1 and POSIZIONE  &lt;= 9   then Round(Qt_A* (5.35 -(POSIZIONE*0.2)))&#xD;&#xA;when POSIZIONE  >= 10 and POSIZIONE  &lt;= 14 then Round(Qt_A*(5.2 -(POSIZIONE*0.167)))&#xD;&#xA;when POSIZIONE  >= 15 and POSIZIONE  &lt;= 21 then Round(Qt_A*(5.2 -(POSIZIONE*0.153)))&#xD;&#xA;when POSIZIONE  >= 22 and POSIZIONE  &lt;= 27 then Round(Qt_A*(5.2 -(POSIZIONE*0.11)))&#xD;&#xA;when POSIZIONE  >= 28 and POSIZIONE  &lt;= 42 then Round(Qt_A*(5.2 -(POSIZIONE*0.11)))&#xD;&#xA;when POSIZIONE  >= 43 then Qt_A&#xD;&#xA;end FVM_CALCOLATO,&#xD;&#xA; case &#xD;&#xA;when POSIZIONE  >= 1 and POSIZIONE   &lt;= 8    then 'TOP'&#xD;&#xA;when POSIZIONE  >= 9 and POSIZIONE   &lt;= 16   then 'SEMITOP' &#xD;&#xA;when POSIZIONE  >= 17 and POSIZIONE  &lt;= 24   then 'TERZA FASCIA'&#xD;&#xA;when POSIZIONE  >= 25 and POSIZIONE  &lt;= 32   then 'QUARTA FASCIA'&#xD;&#xA;when POSIZIONE  >= 33 and POSIZIONE  &lt;= 40   then 'QUINTA FASCIA' &#xD;&#xA;when POSIZIONE  >= 41 and POSIZIONE  &lt;= 49   then 'SESTA FASCIA'&#xD;&#xA;end FASCIA&#xD;&#xA;from &quot;+ context.table_name+ &quot;&#xD;&#xA;where R = 'A' &#xD;&#xA;order by POSIZIONE  ASC&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
