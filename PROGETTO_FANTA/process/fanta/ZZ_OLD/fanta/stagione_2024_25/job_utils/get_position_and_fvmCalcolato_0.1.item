  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="608" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#xA;&#xA;&#xA;output_row.Id = input_row.Id;&#xA;&#xA;context.counter = context.counter +1;&#xA;&#xA;&#xA;&#xA;if (input_row.value &lt; context.value_prev || context.counter == 1){&#xA;&#xD;&#xA;//System.out.println (&quot;ENTRO NELL'IF&quot;);&#xA;&#xD;&#xA;output_row.POSIZIONE = context.counter;&#xA;context.pos_prev = context.counter;&#xA;&#xA;} else {&#xA;//&#x9;System.out.println (&quot;ENTRO NELL'ELSE&quot;);&#xA;&#x9;output_row.POSIZIONE = context.pos_prev;&#x9;&#xA;}&#xA;&#xA;context.value_prev = input_row.value;&#xD;&#xA;&#xA;System.out.println (input_row.Id + &quot; => attuale valore:&quot;+ input_row.value +&quot; | prev_value:&quot;+  context.value_prev + &quot; | POS: &quot; + output_row.POSIZIONE);"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
      <column comment="" key="false" length="-1" name="Id" nullable="true" pattern="" precision="-1" sourceType="INT" type="id_Integer" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="POSIZIONE" nullable="true" pattern="" precision="-1" sourceType="INT" type="id_Integer" originalLength="-1" usefulColumn="true"/>
    </metadata>
  </node>
