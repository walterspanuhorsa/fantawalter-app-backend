    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select id, &#xD;&#xA;case when&#xD;&#xA;     POSIZIONE  >= 1 and POSIZIONE  &lt;= 5   then Round(Qt_A*2 - ((POSIZIONE-1)*0.006))&#xD;&#xA;when POSIZIONE  >= 6 and POSIZIONE  &lt;= 24   then Round(Qt_A*1.8 - ((POSIZIONE-6)*0.006)) &#xD;&#xA;when POSIZIONE  >= 25 and POSIZIONE  &lt;= 42 then Round(Qt_A*1.6 - ((POSIZIONE-25)*0.006))&#xD;&#xA;when POSIZIONE  >= 43  then Round(Qt_A*1.1- ((POSIZIONE-43)*0.012))&#xD;&#xA;end FVM_CALCOLATO,&#xD;&#xA; case &#xD;&#xA;when POSIZIONE  >= 1 and POSIZIONE   &lt;= 5    then 'TOP'&#xD;&#xA;when POSIZIONE  >= 6 and POSIZIONE   &lt;= 24   then 'SEMITOP' &#xD;&#xA;when POSIZIONE  >= 25 and POSIZIONE  &lt;= 40   then 'TERZA FASCIA'&#xD;&#xA;when POSIZIONE  >= 41 and POSIZIONE  &lt;= 49   then 'SCOMMESSE'&#xD;&#xA;end FASCIA&#xD;&#xA;from &quot;+context.table_name+&quot; &#xD;&#xA;WHERE R='C'&quot;"/>
