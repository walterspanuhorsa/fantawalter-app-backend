    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT Id,&#xD;&#xA;case when&#xD;&#xA;     POSIZIONE  >= 1 and POSIZIONE  &lt;= 4   then Round(Qt_A*2.1 -  ((POSIZIONE-1)*0.006))&#xD;&#xA;when POSIZIONE  >= 5 and POSIZIONE  &lt;= 18   then Round(Qt_A*1.4-  ((POSIZIONE-5)*0.006))&#xD;&#xA;when POSIZIONE  >= 19 then Round(Qt_A*1.1-  ((POSIZIONE-19)*0.006))&#xD;&#xA;end moltiplicato,&#xD;&#xA; case &#xD;&#xA;when POSIZIONE  >= 1 and POSIZIONE   &lt;= 4    then 'TOP'&#xD;&#xA;when POSIZIONE  >= 5 and POSIZIONE   &lt;= 18   then 'SEMITOP' &#xD;&#xA;when POSIZIONE  >= 19 and POSIZIONE  &lt;= 41   then 'TERZA FASCIA'&#xD;&#xA;when POSIZIONE  >= 42 and POSIZIONE  &lt;= 76   then 'SCOMMESSE'&#xD;&#xA;end FASCIA&#xD;&#xA;from &quot;+context.table_name+&quot; &#xD;&#xA;WHERE R='D'&quot;"/>
