  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="1160" posY="400">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_5" show="false"/>
    <elementParameter field="CHECK" name="ACTIVATE" value="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#xA;&#xA;//System.out.println(input_row.Nome +&quot; => &quot;+ input_row.FVM_FCit + &quot; &quot; + input_row.FVMC_FCit  + &quot; &quot; + input_row.FVMC_Club + &quot; &quot; +input_row.FVMC_Gds + &quot; &quot; + input_row.FVMC_Fm + &quot; &quot; +input_row.FVMC_Pf);&#xA;&#xA;Integer FVMC_FCit = Relational.ISNULL(input_row.FVMC_FCit)? input_row.FVM_FCit :  input_row.FVMC_FCit;&#xA;Integer FVMC_Club = Relational.ISNULL(input_row.FVMC_Club)? input_row.FVM_FCit :  input_row.FVMC_Club;&#xA;Integer FVMC_Pf = Relational.ISNULL(input_row.FVMC_Pf)? input_row.FVM_FCit :  input_row.FVMC_Pf;&#xA;Integer FVMC_Fm = Relational.ISNULL(input_row.FVMC_Fm)? input_row.FVM_FCit :  input_row.FVMC_Fm;&#xA;Integer FVMC_Gds = Relational.ISNULL(input_row.FVMC_Gds)? input_row.FVM_FCit :  input_row.FVMC_Gds;&#xA;Integer FVMC_Fs = Relational.ISNULL(input_row.FVMC_Fs)? input_row.FVM_FCit :  input_row.FVMC_Fs;&#xA;Integer FVMC_Pazz = Relational.ISNULL(input_row.FVMC_Pazz)? input_row.FVM_FCit :  input_row.FVMC_Pazz;&#xA;&#xA;&#xA;Integer FVM_Carmy = Relational.ISNULL(input_row.FVM_Carmy)? input_row.FVM_FCit :  input_row.FVM_Carmy;&#xA;//Integer LEGHE_GE = Relational.ISNULL(input_row.FVM_GE)? input_row.FVM_FCit :  input_row.FVM_GE;&#xA;Integer FVM_PMA_fl = Relational.ISNULL(input_row.FVM_PMA_fl)? input_row.FVM_FCit :  input_row.FVM_PMA_fl;&#xA;&#xA;Integer FVM_FCit  = input_row.FVM_FCit;&#xA;&#xA;&#xA;Integer[] quotazioni= {FVM_FCit, FVMC_Club, FVMC_Pf, FVMC_Fm, FVMC_Gds, FVMC_Fs, FVMC_Pazz, FVM_Carmy, FVM_PMA_fl, FVMC_FCit };&#xA;&#xA;//riordino l'array&#xA;Arrays.sort(quotazioni);&#xA;&#xA;Integer[] modifiedArray = Arrays.copyOfRange(quotazioni, 1, quotazioni.length);&#xA;&#xA;&#xA;//elimino i due valori più bassi&#xA;modifiedArray = Arrays.copyOfRange(quotazioni, 1, quotazioni.length);&#xA;modifiedArray = Arrays.copyOfRange(quotazioni, 1, quotazioni.length);&#xA;&#xA;//elimino i due valori più alti&#xA;modifiedArray = Arrays.copyOfRange(modifiedArray, 0, modifiedArray.length-1);&#xA;modifiedArray = Arrays.copyOfRange(modifiedArray, 0, modifiedArray.length-1);&#xA;&#xA;quotazioni = modifiedArray;&#xA;&#xA;    double somma; int media;&#xA;&#xA;    somma=0;&#xA;&#xA;    for(int i=0; i&lt;=quotazioni.length-1; i=i+1) {&#xA;    &#xA;    //System.out.println(input_row.Nome + &quot; => &quot; +quotazioni[i]);&#xA;      somma=somma+quotazioni[i];&#xA;    }&#xA;&#xA;    media= (int) Math.round(somma/quotazioni.length);&#xA;&#xA;&#xA;&#xD;&#xA;output_row.id = input_row.id;&#xA;output_row.R = input_row.R;&#xD;&#xA;output_row.Nome = input_row.Nome;&#xD;&#xA;output_row.Squadra = input_row.Squadra;&#xA;&#xD;&#xA;output_row.MEDIA_TRONCATA = media;&#xA;output_row.FVM_FCit =FVM_FCit;&#xA;output_row.LEGHE_GE = LEGHE_GE;&#xA;output_row.LEGHE_FL = LEGHE_FL;&#xA;output_row.Carmy_Prezzo = Carmy_Prezzo;&#xA;&#xA;output_row.giocate = input_row.giocate;&#xA;output_row.mediavoto = input_row.mediavoto;&#xA;output_row.fantamedia = input_row.fantamedia;&#xA;&#xA;&#xA;output_row.TIT = input_row.TIT;&#xA;output_row.SICU = input_row.SICU;&#xA;output_row.INF = input_row.INF;&#xA;output_row.Note = input_row.Note;&#xA;&#xA;output_row.FASCIA = null;&#xA;output_row.POSIZIONE = null;&#xA;&#xD;&#xA;output_row.FVMC_FCit  =  input_row.FVMC_FCit;&#xA;output_row.FVMC_Club  =  input_row.FVMC_Club;&#xA;output_row.FVMC_Gds   =  input_row.FVMC_Gds;&#xA;output_row.FVMC_Fm    =  input_row.FVMC_Fm;&#xA;output_row.FVMC_Pf    =  input_row.FVMC_Pf;&#xA;output_row.FVMC_Fs    =  input_row.FVMC_Fs;&#xA;output_row.FVMC_Pazz  =  input_row.FVMC_Pazz;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="import java.util.Arrays;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_5">
