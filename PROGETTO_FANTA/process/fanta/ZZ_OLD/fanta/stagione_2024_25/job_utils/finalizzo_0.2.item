  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="800" posY="240">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="&#xA;//popolo l'array&#xA;Integer[] quotazioni= {input_row.FVM_FCit, input_row.FVM_Carmy, input_row.FVM_PMA_fl, input_row.FVMC_FCit, input_row.FVMC_Club, input_row.FVMC_Pf, input_row.FVMC_Fm, input_row.FVMC_Gds, input_row.FVMC_Fs, input_row.FVMC_Pazz };&#xA;&#xA;&#xA;//riordino l'array&#xA;Arrays.sort(quotazioni);&#xA;&#xA;//creo un array di lavoro&#xA;Integer[] modifiedArray = Arrays.copyOfRange(quotazioni, 1, quotazioni.length);&#xA;&#xA;&#xA;//elimino i due valori più bassi&#xA;modifiedArray = Arrays.copyOfRange(quotazioni, 1, quotazioni.length);&#xA;modifiedArray = Arrays.copyOfRange(quotazioni, 1, quotazioni.length);&#xA;&#xA;//elimino i due valori più alti&#xA;modifiedArray = Arrays.copyOfRange(modifiedArray, 0, modifiedArray.length-1);&#xA;modifiedArray = Arrays.copyOfRange(modifiedArray, 0, modifiedArray.length-1);&#xA;&#xA;quotazioni = modifiedArray;&#xA;&#xA;    double somma; int media;&#xA;&#xA;    somma=0;&#xA;&#xA;    for(int i=0; i&lt;=quotazioni.length-1; i=i+1) {&#xA;    &#xA;    //System.out.println(input_row.Nome + &quot; => &quot; +quotazioni[i]);&#xA;      somma=somma+quotazioni[i];&#xA;    }&#xA;    &#xA;&#x9;//produco la media arrotondando il valore ottenuto&#xA;    media= (int) Math.round(somma/quotazioni.length);&#xA;    &#xA;    &#xA;    &#xA;output_row.id = input_row.id;&#xA;&#xA;output_row.MEDIA_TRONCATA = media;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="import java.io.*; &#xA;import java.lang.*; &#xA;import java.util.*; &#xA;&#xA;import java.lang.reflect.Field;  "/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
      <column comment="" defaultValue="" key="false" length="11" name="id" nullable="true" pattern="" precision="0" sourceType="INT" type="id_Integer" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="MEDIA_TRONCATA" nullable="true" pattern="" precision="-1" sourceType="" type="id_Integer" originalLength="-1" usefulColumn="true"/>
    </metadata>
  </node>
