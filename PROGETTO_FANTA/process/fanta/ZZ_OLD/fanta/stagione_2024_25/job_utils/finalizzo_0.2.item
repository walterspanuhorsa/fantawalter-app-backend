    <elementParameter field="MEMO_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#xA;&#xA;&#xA;output_row.Id = input_row.Id;&#xA;&#xA;context.counter = context.counter +1;&#xA;&#xA;&#xA;&#xA;if (input_row.value &lt; context.value_prev || context.counter == 1){&#xA;&#xA;//System.out.println (&quot;ENTRO NELL'IF&quot;);&#xA;&#xA;output_row.POSIZIONE = context.counter;&#xA;context.pos_prev = context.counter;&#xA;&#xA;} else {&#xA;//&#x9;System.out.println (&quot;ENTRO NELL'ELSE&quot;);&#xA;&#x9;output_row.POSIZIONE = context.pos_prev;&#x9;&#xA;}&#xA;&#xA;context.value_prev = input_row.value;&#xA;&#xA;//System.out.println (input_row.Id + &quot; => attuale valore:&quot;+ input_row.value +&quot; | prev_value:&quot;+  context.value_prev + &quot; | POS: &quot; + context.counter);"/>
