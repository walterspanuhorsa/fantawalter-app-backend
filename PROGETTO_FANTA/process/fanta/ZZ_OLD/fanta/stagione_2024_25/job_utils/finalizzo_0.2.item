    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT DISTINCT FCit.id, FCit.R RUOLO,&#xD;&#xA;FCit.Nome, FCit.Squadra, &#xD;&#xA;fl.Titolarita as TIT,&#xD;&#xA;fl.Affidabilita as SICU,&#xD;&#xA;fl.Integrita as INF,&#xD;&#xA;FCit.FVM  as FVM_FCit,&#xD;&#xA;fl.Prezzo as FVM_Carmy,&#xD;&#xA;fl.PMA  as FVM_PMA_fl,&#xD;&#xA;FCit.FVM_CALCOLATO as FVMC_FCit,&#xD;&#xA;club.FVM_CALCOLATO as FVMC_Club,&#xD;&#xA;pf.FVM_CALCOLATO  as FVMC_Pf,&#xD;&#xA;Fm.FVM_CALCOLATO as FVMC_Fm,&#xD;&#xA;gds.FVM_CALCOLATO  as FVMC_Gds,&#xD;&#xA;fs.FVM_CALCOLATO  as FVMC_Fs,&#xD;&#xA;pazz.FVM_CALCOLATO  as FVMC_Pazz,&#xD;&#xA;COALESCE(fl.Nota_1,''), COALESCE(fl.Nota_2,''), COALESCE(fl.Nota_3,''), COALESCE(fl.Nota_4,''), COALESCE(fl.Nota_5,'') &#xD;&#xA;FROM fanta.listone_fantacalcioit FCit&#xD;&#xA;left join fanta.fantaclub_listone club &#xD;&#xA;&#x9;on club.id_fantacalcio = FCit.id&#xD;&#xA;left join fanta.fantagazzetta_listone gds &#xD;&#xA;&#x9;on gds.id_fantacalcio = FCit.id&#xD;&#xA;left join fanta.fantamaster_listone Fm   &#xD;&#xA;&#x9;on Fm.id_fantacalcio = FCit.id&#xD;&#xA;left join pianetafanta_listone pf &#xD;&#xA;&#x9;on Pf.id_fantacalcio = fcit.id&#xD;&#xA;left join fantasoccer_listone  fs &#xD;&#xA;&#x9;on fs.id_fantacalcio = fcit.id&#xD;&#xA;left join fantapazz_listone pazz &#xD;&#xA;&#x9;on pazz.id_fantacalcio = fcit.id&#xD;&#xA;left join fantalab_listone fl &#xD;&#xA;&#x9;on fl.id_fantacalcio = fcit.id&#xD;&#xA;WHERE FCit.POSIZIONE is not null &#xD;&#xA;ORDER BY FCit.FVM  desc&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
