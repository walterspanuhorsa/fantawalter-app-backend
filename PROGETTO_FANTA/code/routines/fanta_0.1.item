package routines;

/*
 * user specification: the function's comment should contain keys as follows: 1. write about the function's comment.but
 * it must be before the "{talendTypes}" key.
 * 
 * 2. {talendTypes} 's value must be talend Type, it is required . its value should be one of: String, char | Character,
 * long | Long, int | Integer, boolean | Boolean, byte | Byte, Date, double | Double, float | Float, Object, short |
 * Short
 * 
 * 3. {Category} define a category for the Function. it is required. its value is user-defined .
 * 
 * 4. {param} 's format is: {param} <type>[(<default value or closed list values>)] <name>[ : <comment>]
 * 
 * <type> 's value should be one of: string, int, list, double, object, boolean, long, char, date. <name>'s value is the
 * Function's parameter name. the {param} is optional. so if you the Function without the parameters. the {param} don't
 * added. you can have many parameters for the Function.
 * 
 * 5. {example} gives a example for the Function. it is optional.
 */
public class fanta {

    /**
     * helloExample: not return value, only print "hello" + message.
     * 
     * 
     * {talendTypes} String
     * 
     * {Category} User Defined
     * 
     * {param} string("world") input: The string need to be printed.
     * 
     * {example} helloExemple("world") # hello world !.
     */
    public static void helloExample(String message) {
        if (message == null) {
            message = "World"; //$NON-NLS-1$
        }
        System.out.println("Hello " + message + " !"); //$NON-NLS-1$ //$NON-NLS-2$
    }
    
    public static int getMaxVal(int IA, int counter) {
    	System.out.println("IA :" + IA + " counter:" + counter );
    	
    	int maxVal= 0;
    	if (counter <= 16) {
    		// =ARROTONDA((G4-75)*8,5)
    		maxVal = (int) Math.round(Double.valueOf((IA-75))*8.5);
    	} else {
    		maxVal = (IA-75)*8;
    	}
    	return maxVal;
    }
    
    
    public static int returnXpValue(String csv_value) {
    	
    	System.out.println(csv_value);
    	
    	int xpValue = 0;
    	
    	if (csv_value.contains("-")) {
    		String[] aValues = csv_value.split("-");

    		xpValue = (int)Math.round(Double.parseDouble(aValues[0]));
 
    		
    	}else if (csv_value.contains("+")) {
    		String[] aValues = csv_value.split("\\+");

    		xpValue = (int)Math.round(Double.parseDouble(aValues[0]));
    	}
    	
    	
    	return xpValue;
    }
    
    public static String returnName (String Name, String Ruolo) {
    	Name = Name.toLowerCase();
    	String[] splited = Name.split("\\s+");
    	splited[0] = splited[0].substring(0, 1).toUpperCase() + splited[0].substring(1);
    	
    	System.out.println (Name + "=> " + splited[1]);
    	
    	if( Name.equals("di francesco f") ) {
    		return "Di Francesco F.";
    	}
    	
    	if (splited[0].equals("El") || splited[0].equals("Di") || splited[0].equals("De") ) {
    		return splited[0] + " " +  splited[1].substring(0, 1).toUpperCase() + splited[1].substring(1);
    		
    	}
    	
     	if (Name.equals("alex sandro l") || Name.equals("akpa akpro j") || Name.equals("carlos augusto -") || Name.equals("nicolussi caviglia h") || Name.equals("marcos antonio -") || Name.equals("luis alberto r")
     			|| Name.equals("mario rui s")  ||  Name.equals("martinez quarta l") ){
     		return splited[0] + " " + splited[1];
     	}
    	
    	if (splited[0].equals("Alvarez") ||  splited[0].equals("Camara") ||  splited[0].equals("Carboni")  ||  splited[0].equals("Coda") || splited[0].equals("Coulibaly") ||  splited[0].equals("Ferrari") || splited[0].equals("Gonzalez")  
    			|| splited[0].equals("Gudmundsson") || splited[0].equals("Henderson") || splited[0].equals("Hernandez")  || splited[0].equals("Kamara")
    			|| splited[0].equals("Lopez")  || splited[0].equals("Llorente")  || splited[0].equals("Martinez") || splited[0].equals("Moro") ||  splited[0].equals("Perez")
    			|| splited[0].equals("Ricci") || splited[0].equals("Ranocchia") || splited[0].equals("Rodriguez")  ||  splited[0].equals("Valencia")  || splited[0].equals("Zapata") 

    			)	 {
    		return splited[0] + " " + splited[1].substring(0, 1).toUpperCase() +".";
    	}
    	

    	
    	if (splited[0].equals("Leao")) {
    		return "Rafael Leao";
    	}
    	
    	if (Name.equals("dany mota m")){
    		return "Mota";
    	}
    	
    	if( splited[0].equals("Toure")) {
    		return "Toure' E.";
    	}

    	if (Name.equals("anderson f")) {
    		return "Felipe Anderson";
    	}
    	 
     	if (splited[0].equals("Pellegrini") && Ruolo.equals("C") ) {
     		return "Pellegrini Lo.";
    	}
     	
     	if (splited[0].equals("Pellegrini") && Ruolo.equals("D") ) {
     		return "Pellegrini Lu.";	
    	}
     	
     	if (Name.equals("anguissa a")) {
     		return "Zambo Anguissa";
     	}
     	
     	if (Name.equals("ederson -")) {
     		return "Ederson D.s.";
     	}
     	
     	if (Name.equals("henrique m")){
     		return "Matheus Henrique";
     	}
     	
     	if (Name.equals("arthur -")){
     		return "Arthur Melo";
     	}
     	
     	if (Name.equals("iling-junior s")){
     		return "Iling Junior";
     	}
     	
     	if (Name.equals("sulemana s")){
     		return "Sulemana I.";
     	}
     
     	if (Name.equals("pezzella g")){
     		return "Pezzella Giu.";
     	}
     
     	if(Name.equals("d’ambrosio d")){
     		return "Dambrosio";
     	}
     	
     	
    	return splited[0];
    		
    	}
    	
    
    
    
}
