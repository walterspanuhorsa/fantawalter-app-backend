    <elementParameter field="MEMO_JAVA" name="CODE_START" value="// start part of your Java code&#xA;java.util.ArrayList&lt;java.util.HashMap&lt;String,String>> links = routines.HTMLScrapingTools.findLinks(((String)globalMap.get(&quot;row1.ResponseContent&quot;)));&#xA;&#xA;&#xA;java.util.Iterator&lt;java.util.HashMap&lt;String,String>> it = links.iterator();&#xA;&#xA;while(it.hasNext()){&#xA;&#xA;"/>
